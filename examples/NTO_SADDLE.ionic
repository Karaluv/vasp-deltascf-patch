MODE SECANT
SPIN 2
HOLE_BAND 192
N_OCC_BETA 191
REF_HOLE_BAND 191
REF_PART_BAND 192
ETA -1
PRINT_EVERY 1
STOP_ON_EDIFF_ONLY F
STOP_G_MODE_MAX 6.5E-5
STOP_RPERP_EST_MAX 1E-4
STOP_RPERP_SUB_MAX 3E-4
STOP_DE_MAX 5E-8
STOP_H_MAX 0.08
STOP_P_MIN 0.90
STOP_C_ABS_MAX 0.02
STOP_MIN_STEP 20
STOP_STABLE_STEPS 3
FAST_PATH T
TRACE_FULL_DIAG F
TRUST_C T
TRUST_C_MAX 0.015

# Calibrated defaults; no rebuild needed for these controls.
SECANT_DAMPING 0.35
SECANT_CAP_FACTOR 2.5
SECANT_MAX_ANGLE 0.02

IONIC_FOLLOW T
IONIC_N_PROJECT 8
IONIC_N_REFLECT 5
IONIC_TIME 0.08
IONIC_MIN_STEP 6
IONIC_STABLE_STEPS 2
IONIC_STOP_H_MAX 0.05
IONIC_STOP_P_MIN 0.90
IONIC_STOP_C_MAX 0.08
SAVE_IONIC_REFERENCE T
