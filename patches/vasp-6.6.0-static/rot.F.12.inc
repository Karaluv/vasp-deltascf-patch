! S1 diagnostic only. Full PAW overlap; no changes to orbitals or occupations.
! This reports EDWAV's actual applied-H subspace residual, not a full-space
! residual and not proof that local density and exchange derive from same P.
 SUBROUTINE NTO_SADDLE_TRACE(W,WDES,LATT_CUR,CQIJ,LMDIM,NONLR_S,NONL_S,IO,CHAM,NEL,IROT,IFLAG,BTRIAL,EFERMI,LCHCON)
__GPU USE moffload
 USE prec
 USE base
 USE wave
 USE wave_high, ONLY: ELEMENTS
 USE lattice
 USE nonl_struct_def
 USE nonlr_struct_def
 USE nonl_high, ONLY: PROALL
 USE fileio, ONLY: INWAV_ALTERNATIVE,OUTWAV
 USE choleski, ONLY: CALC_PAW_OVERLAP
 USE fock_ace, ONLY: LFOCK_ACE
 USE tutor, ONLY: vtutor
 IMPLICIT NONE
 TYPE(wavespin) :: W
 TYPE(wavedes) :: WDES
 TYPE(latt) :: LATT_CUR
 TYPE(nonlr_struct) :: NONLR_S
 TYPE(nonl_struct) :: NONL_S
 TYPE(in_struct) :: IO
 INTEGER :: LMDIM,NEL,IROT,IFLAG
 REAL(q) :: BTRIAL,EFERMI
 OVERLAP :: CQIJ(LMDIM,LMDIM,WDES%NIONS,WDES%NCDIJ)
 GDEF :: CHAM(WDES%NB_TOT,WDES%NB_TOT,WDES%NKPTS,WDES%ISPIN)
 TYPE(wavespin), SAVE :: REF
 TYPE(wavedes1) :: WD1
 LOGICAL,SAVE :: INIT=.FALSE., ENABLED=.FALSE.
 LOGICAL :: EXISTS,LREAD,ACEACTIVE,STOP_ENERGY_ONLY,LCHCON
 INTEGER :: U,IOS,I,J,NB,SPIN,HOLE,NOCC,EVERY
 CHARACTER(LEN=512) :: LINE,KEY,VALUE
 CHARACTER(LEN=32),SAVE :: MODE='OFF'
 CHARACTER(LEN=8) :: ACESTR,FOCKSTR,ACEUSED
 GDEF,ALLOCATABLE :: C(:,:)
 REAL(q) :: H,P,COH,CMAX,LH,LP,GM,RSUB,RPERP,HOLEWEIGHT,INPUT_ETA,REXT,REST_TOTAL,REST_PERP
 IF (.NOT.INIT) THEN
  INIT=.TRUE.
  INQUIRE(FILE='NTO_SADDLE',EXIST=EXISTS)
  IF (.NOT.EXISTS) RETURN
  SPIN=2;HOLE=192;NOCC=191;EVERY=1;STOP_ENERGY_ONLY=.TRUE.;INPUT_ETA=1._q
  OPEN(NEWUNIT=U,FILE='NTO_SADDLE',STATUS='OLD',ACTION='READ',IOSTAT=IOS)
  IF (IOS/=0) CALL vtutor%error('NTO_SADDLE: cannot open configuration')
  DO
   READ(U,'(A)',IOSTAT=IOS) LINE
   IF (IOS<0) EXIT
   IF (IOS/=0) CALL vtutor%error('NTO_SADDLE: configuration read error')
   LINE=ADJUSTL(LINE)
   IF (LEN_TRIM(LINE)==0.OR.LINE(1:1)=='#') CYCLE
   READ(LINE,*,IOSTAT=IOS) KEY,VALUE
   IF (IOS/=0) CALL vtutor%error('NTO_SADDLE: expected key and value')
   SELECT CASE(TRIM(KEY))
   CASE('MODE')
    MODE=TRIM(VALUE)
   CASE('SPIN')
    READ(VALUE,*,IOSTAT=IOS) SPIN
   CASE('HOLE_BAND')
    READ(VALUE,*,IOSTAT=IOS) HOLE
   CASE('N_OCC')
    READ(VALUE,*,IOSTAT=IOS) NOCC
   CASE('PRINT_EVERY')
    READ(VALUE,*,IOSTAT=IOS) EVERY
   CASE('ETA')
    READ(VALUE,*,IOSTAT=IOS) INPUT_ETA
   CASE('STOP_G_MODE_MAX')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_STOP_G
   CASE('STOP_RPERP_EST_MAX')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_STOP_REST
   CASE('STOP_RPERP_SUB_MAX')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_STOP_RSUB
   CASE('STOP_DE_MAX')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_STOP_DE
   CASE('STOP_H_MAX')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_STOP_H
   CASE('STOP_P_MIN')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_STOP_P
   CASE('STOP_C_ABS_MAX')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_STOP_C
   CASE('STOP_MIN_STEP')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_STOP_MIN_STEP
   CASE('STOP_STABLE_STEPS')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_STOP_STEPS
   CASE('STOP_ON_EDIFF_ONLY')
    READ(VALUE,*,IOSTAT=IOS) STOP_ENERGY_ONLY
   CASE DEFAULT
    CALL vtutor%error('NTO_SADDLE: unknown configuration key')
   END SELECT
   IF (IOS/=0) CALL vtutor%error('NTO_SADDLE: invalid parameter')
  ENDDO
  CLOSE(U)
  IF (MIN(SADDLE_STOP_G,SADDLE_STOP_REST,SADDLE_STOP_RSUB, &
      SADDLE_STOP_DE,SADDLE_STOP_H,SADDLE_STOP_P,SADDLE_STOP_C)<=0._q.OR. &
      SADDLE_STOP_H>=1._q.OR.SADDLE_STOP_P>=1._q.OR. &
      SADDLE_STOP_MIN_STEP<2.OR.SADDLE_STOP_STEPS<1) &
   CALL vtutor%error('NTO_SADDLE: invalid runtime stop thresholds')
  IF(IO%IU6>=0) THEN
   WRITE(IO%IU6,'(A)') 'NTO_SADDLE runtime stop policy r2 (raw estimated residual)'
   WRITE(IO%IU6,'(A,ES24.16)') 'STOP_G_MODE_MAX = ',SADDLE_STOP_G
   WRITE(IO%IU6,'(A,ES24.16)') 'STOP_RPERP_EST_MAX = ',SADDLE_STOP_REST
   WRITE(IO%IU6,'(A,ES24.16)') 'STOP_RPERP_SUB_MAX = ',SADDLE_STOP_RSUB
   WRITE(IO%IU6,'(A,ES24.16)') 'STOP_DE_MAX = ',SADDLE_STOP_DE
   WRITE(IO%IU6,'(A,ES24.16)') 'STOP_H_MAX = ',SADDLE_STOP_H
   WRITE(IO%IU6,'(A,ES24.16)') 'STOP_P_MIN = ',SADDLE_STOP_P
   WRITE(IO%IU6,'(A,ES24.16)') 'STOP_C_ABS_MAX = ',SADDLE_STOP_C
   WRITE(IO%IU6,'(A,2I8)') 'STOP_MIN_STEP,STOP_STABLE_STEPS = ',SADDLE_STOP_MIN_STEP,SADDLE_STOP_STEPS
  ENDIF
  SELECT CASE(TRIM(MODE))
  CASE('OFF')
   SADDLE_MODE=0;SADDLE_ETA=1._q
   IF (.NOT.STOP_ENERGY_ONLY) CALL vtutor%error('NTO_SADDLE OFF: residual stop rule not implemented')
  CASE('PROJECT')
   SADDLE_MODE=1;SADDLE_ETA=0._q
   IF (ABS(INPUT_ETA)>1E-12_q) CALL vtutor%error('NTO_SADDLE PROJECT requires ETA 0')
  CASE('REFLECT')
   SADDLE_MODE=2;SADDLE_ETA=-1._q
   IF (ABS(INPUT_ETA+1._q)>1E-12_q) CALL vtutor%error('NTO_SADDLE REFLECT requires ETA -1')
  CASE('SECANT')
   SADDLE_MODE=3;SADDLE_ETA=-1._q
   IF (ABS(INPUT_ETA+1._q)>1E-12_q) CALL vtutor%error('NTO_SADDLE SECANT requires ETA -1')
  CASE DEFAULT
   CALL vtutor%error('NTO_SADDLE: unsupported mode')
  END SELECT
  SADDLE_STOP_EDIFF=STOP_ENERGY_ONLY
  IF (SADDLE_MODE/=0.AND.STOP_ENERGY_ONLY) &
   CALL vtutor%error('NTO_SADDLE: PROJECT/REFLECT must disable energy-only stopping')
  IF (SPIN/=2.OR.HOLE/=192.OR.NOCC/=191.OR.EVERY/=1) &
   CALL vtutor%error('NTO_SADDLE S1: requires SPIN 2, HOLE_BAND 192, N_OCC 191, PRINT_EVERY 1')
  IF (WDES%COMM%NCPU/=1.OR.WDES%NKPTS/=1.OR.WDES%ISPIN/=2.OR.WDES%NB_TOT/=224) &
   CALL vtutor%error('NTO_SADDLE S1: requires 1 MPI rank, Gamma, 2 spins, NBANDS=224')
#ifndef wNGXhalf
#ifndef wNGZhalf
  CALL vtutor%error('NTO_SADDLE S1: requires Gamma-real binary')
#endif
#endif
__GPU CALL OFFLOAD_ON_PUSH(.FALSE.)
  CALL INWAV_ALTERNATIVE(IO,WDES,REF,WDES%GRID,LATT_CUR,LREAD,'qqq')
  IF (.NOT.LREAD) CALL vtutor%error('NTO_SADDLE S1: missing WAVECAR.qqq reference')
  CALL PROALL(WDES%GRID,LATT_CUR,NONLR_S,NONL_S,REF)
__GPU CALL OFFLOAD_ON_POP
  OPEN(NEWUNIT=U,FILE='NTO_SADDLE_TRACE.csv',STATUS='REPLACE',ACTION='WRITE')
  WRITE(U,'(A)') 'step,iflag,mode,eta,TIME,h,p,c_re,c_abs,c_over_cmax,ell_h,ell_p,'// &
   'p_occ_norm,hole192_weight,ferdo191,ferdo192,g_mode_re,R_mode,R_perp_subspace,R_subspace,'// &
   'R_external_raw_PAW,R_perp_est_normalized,R_total_est_normalized,'// &
   'rot_path,Fock_action_kind,ACE_active,ACE_feature_enabled,stop_rule,full_residual'
  CLOSE(U)
  ENABLED=.TRUE.
  IF(IO%IU6>=0) WRITE(IO%IU6,'(A)') &
   'NTO_SADDLE: applied-H subspace diagnostic; full residual and final acceptance MISSING'
 ENDIF
 IF (.NOT.ENABLED.OR.IFLAG==2) RETURN
 IF (IROT/=3) CALL vtutor%error('NTO_SADDLE S1: unsupported IROT; no untracked rotation allowed')
 ACEACTIVE=LFOCK_ACE()
GPACC !$ACC WAIT IF(OFFLOAD_ON)
GPACC !$ACC UPDATE SELF(W%CW,W%CPROJ,W%FERTOT,CHAM) IF(OFFLOAD_ON)
__GPU CALL OFFLOAD_ON_PUSH(.FALSE.)
 NB=WDES%NB_TOT
 ALLOCATE(C(NB,NB))
 CALL SETWDES(WDES,WD1,1)
 CALL CALC_PAW_OVERLAP(ELEMENTS(W,WD1,2),ELEMENTS(REF,WD1,2),CQIJ,C)
 IF (MAXVAL(ABS(W%FERTOT(1:191,1,2)-1._q))>1E-7_q.OR. &
     MAXVAL(ABS(W%FERTOT(192:NB,1,2)))>1E-7_q) &
  CALL vtutor%error('NTO_SADDLE S1: unexpected FERDO')
 H=SUM(ABS(C(1:191,191))**2)
 P=SUM(ABS(C(1:191,192))**2)
 COH=REAL(SUM(C(1:191,191)*GCONJG(C(1:191,192))),q)
 HOLEWEIGHT=ABS(C(192,191))**2
 CMAX=SQRT(MAX(0._q,MIN(H*(1-H),P*(1-P))))
 LH=H*(1-H)-COH*COH; LP=P*(1-P)-COH*COH
 IF(P<=1E-14_q) CALL vtutor%error('NTO_SADDLE: particle projection is zero')
 IF(SADDLE_MODE/=0) THEN
  IF(P<0.5_q.OR.HOLEWEIGHT<0.5_q) THEN
   CALL OUTWAV(IO,WDES,W,LATT_CUR,EFERMI,EXT='BAD')
   CALL vtutor%error('NTO_SADDLE: NTO mode identity lost; WAVECAR.BAD saved')
  ENDIF
  IF(.NOT.ALLOCATED(SADDLE_V)) ALLOCATE(SADDLE_V(191))
  SADDLE_V=REAL(C(1:191,192),q);SADDLE_P=P;SADDLE_H=H;SADDLE_C_ABS=ABS(COH)
 ENDIF
 GM=0
 DO I=1,191
  GM=GM+REAL(CHAM(192,I,1,2)*C(I,192),q)/SQRT(P)
 ENDDO
 SADDLE_G_RAW=GM
 ! Positive scalar made from stock ROTINI's orbital gaps and its EH=0.35
 ! response factor. Used only when SECANT must bootstrap a vanished mode.
 SADDLE_DENOM=0._q
 DO I=1,191
  SADDLE_DENOM=SADDLE_DENOM+REAL(C(I,192),q)**2* &
       (ABS(REAL(CHAM(192,192,1,2)-CHAM(I,I,1,2),q))+MERGE(0._q,1.4_q,LCHCON))
 ENDDO
 SADDLE_DENOM=SADDLE_DENOM/P
 RSUB=0
 DO I=1,191
  DO J=192,NB
   RSUB=RSUB+ABS(CHAM(J,I,1,2))**2
  ENDDO
 ENDDO
 RPERP=SQRT(MAX(0._q,RSUB-GM*GM));RSUB=SQRT(RSUB)
 REXT=SQRT(MAX(0._q,SADDLE_RAW_EXT2))
 REST_PERP=SQRT((RPERP**2+REXT**2)/191._q);REST_TOTAL=SQRT((RSUB**2+REXT**2)/191._q)
 SADDLE_RPERP_EST=REST_PERP;SADDLE_RPERP_SUB=RPERP
 ACESTR='F'
 IF(ACEACTIVE) ACESTR='T'
#ifdef fock_dblbuf
 ! EDWAV directly calls FOCK_ALL_DBLBUF; LFOCK_ACE only reports availability.
 FOCKSTR='full';ACEUSED='F'
#else
 FOCKSTR='MISSING';ACEUSED='MISSING'
#endif
 OPEN(NEWUNIT=U,FILE='NTO_SADDLE_TRACE.csv',STATUS='OLD',POSITION='APPEND',ACTION='WRITE')
 WRITE(U,'(I0,",",I0,",",A,",",ES24.16,",",ES24.16,18(",",ES24.16),",EDWAV+IROT3,",A,",",A,",",A,",MISSING,MISSING")') &
  NEL,IFLAG,TRIM(MODE),SADDLE_ETA,BTRIAL,H,P,COH,ABS(COH),MERGE(ABS(COH)/MAX(CMAX,TINY(CMAX)),0._q,CMAX>0),LH,LP, &
  P,HOLEWEIGHT,W%FERTOT(191,1,2),W%FERTOT(192,1,2),GM,ABS(GM),RPERP,RSUB,REXT,REST_PERP,REST_TOTAL,TRIM(FOCKSTR),TRIM(ACEUSED),TRIM(ACESTR)
 CLOSE(U)
 IF(IO%IU6>=0) WRITE(IO%IU6,'(A,I5,A,5ES18.9)') &
  'NTO_SADDLE S1 n=',NEL,' h,p,c,g_mode,R_subspace ',H,P,COH,GM,RSUB
 DEALLOCATE(C)
__GPU CALL OFFLOAD_ON_POP
 END SUBROUTINE NTO_SADDLE_TRACE

! Experimental IROT=3 one-mode map, Gamma-real / one MPI only.
! CHF is not the PAW tangent by itself. Include the PAW projection of W_F;
! ROT2 uses its upper triangle and ORTHCH supplies the corresponding lower.
 SUBROUTINE NTO_SADDLE_PROJECT(W,WF,WDES,LATT_CUR,CQIJ,LMDIM,CHF,IO,NEL,IROT,EFERMI,BTRIAL)
__GPU USE moffload
 USE prec
 USE base
 USE wave
 USE wave_high, ONLY: ELEMENTS
 USE lattice
 USE fileio, ONLY: OUTWAV
 USE choleski, ONLY: CALC_PAW_OVERLAP
 USE tutor, ONLY: vtutor
 USE, INTRINSIC :: ieee_arithmetic, ONLY: ieee_is_finite
 IMPLICIT NONE
 TYPE(wavespin) :: W,WF
 TYPE(wavedes) :: WDES
 TYPE(latt) :: LATT_CUR
 TYPE(wavedes1) :: WD1
 TYPE(in_struct) :: IO
 INTEGER :: LMDIM,NEL,IROT,I,J,NB
 OVERLAP :: CQIJ(LMDIM,LMDIM,WDES%NIONS,WDES%NCDIJ)
 GDEF :: CHF(WDES%NB_TOT,WDES%NB_TOT,WDES%NKPTS,WDES%ISPIN)
 GDEF, ALLOCATABLE :: OV(:,:)
 REAL(q) :: DI,A,DELTA,ANTIERR,DNORM,EFERMI,BTRIAL,TARGET,DTHETA,DG,DT
 IF(IROT/=3.OR..NOT.ALLOCATED(SADDLE_V)) CALL vtutor%error('NTO_SADDLE: unsupported step path')
GPACC !$ACC WAIT IF(OFFLOAD_ON)
GPACC !$ACC UPDATE SELF(W%CW,W%CPROJ,W%FERTOT,WF%CW,WF%CPROJ,CHF) IF(OFFLOAD_ON)
__GPU CALL OFFLOAD_ON_PUSH(.FALSE.)
 NB=WDES%NB_TOT
 IF(.NOT.SADDLE_W0_READY) THEN
  CALL ALLOCW(WDES,SADDLE_W0)
  CALL ALLOCW(WDES,SADDLE_WF0)
  SADDLE_W0_READY=.TRUE.
 ENDIF
 SADDLE_W0%CW=W%CW;SADDLE_W0%CPROJ=W%CPROJ;SADDLE_W0%FERTOT=W%FERTOT
 SADDLE_WF0%CW=WF%CW;SADDLE_WF0%CPROJ=WF%CPROJ
 SADDLE_CORRECTION=0._q;SADDLE_BEST_ERR=HUGE(1._q);SADDLE_RELAXED=.FALSE.
 ALLOCATE(OV(NB,NB));CALL SETWDES(WDES,WD1,1)
 CALL CALC_PAW_OVERLAP(ELEMENTS(W,WD1,2),ELEMENTS(WF,WD1,2),CQIJ,OV)
 A=0;ANTIERR=0;DNORM=0
 DO I=1,191
  DI=REAL(CHF(I,192,1,2)+OV(192,I),q)
  A=A+SADDLE_V(I)*DI
  ANTIERR=MAX(ANTIERR,ABS(REAL(CHF(I,192,1,2)+CHF(192,I,1,2),q)))
  DO J=192,NB
   DNORM=DNORM+ABS(CHF(I,J,1,2)+OV(J,I))**2
  ENDDO
 ENDDO
 A=A/SADDLE_P;DNORM=SQRT(DNORM)
 IF(SADDLE_MODE==2.AND.NEL>=2.AND.ABS(SADDLE_G_RAW)>1E-5_q.AND.ABS(A)<1E-10_q) THEN
  CALL OUTWAV(IO,WDES,W,LATT_CUR,EFERMI,EXT='BAD')
  CALL vtutor%error('NTO_SADDLE REFLECT: raw mode gradient nonzero but step direction vanished; WAVECAR.BAD saved')
 ENDIF
 IF(.NOT.ieee_is_finite(A).OR..NOT.ieee_is_finite(DNORM)) &
  CALL vtutor%error('NTO_SADDLE: nonfinite step')
 IF(ANTIERR>1E-7_q) CALL vtutor%error('NTO_SADDLE: CHF anti-symmetry unsupported')
 SADDLE_A_IN=A
 TARGET=SADDLE_ETA*A;SADDLE_STEP_KIND='REFLECT_FALLBACK'
 IF(SADDLE_MODE==1) SADDLE_STEP_KIND='PROJECT'
 IF(SADDLE_MODE==2) SADDLE_STEP_KIND='REFLECT'
 IF(NEL==1) THEN
  ! Initial SDA step: project the mode for every active optimizer; do not
  ! bootstrap, reflect, or store secant history until the following step.
  TARGET=0._q;SADDLE_STEP_KIND='INITIAL_PROJECT'
 ELSE IF(SADDLE_MODE==3) THEN
  IF(SADDLE_HISTORY) THEN
   DG=SADDLE_G_RAW-SADDLE_PREV_G;DT=SADDLE_THETA-SADDLE_PREV_THETA
   IF(ABS(DG)>1E-8_q.AND.ABS(DT)>1E-10_q) THEN
    DTHETA=-0.35_q*SADDLE_G_RAW*DT/DG
    DTHETA=MAX(-0.02_q,MIN(0.02_q,DTHETA))
    TARGET=-DTHETA/(BTRIAL*SQRT(SADDLE_P))
    SADDLE_STEP_KIND='SECANT'
   ENDIF
  ENDIF
  IF(SADDLE_STEP_KIND=='REFLECT_FALLBACK'.AND.ABS(TARGET)<1E-10_q.AND.ABS(SADDLE_G_RAW)>1E-5_q) THEN
   IF(SADDLE_DENOM<=1E-8_q.OR..NOT.ieee_is_finite(SADDLE_DENOM)) &
    CALL vtutor%error('NTO_SADDLE SECANT: invalid bootstrap denominator')
   TARGET=-SADDLE_G_RAW/(SQRT(SADDLE_P)*SADDLE_DENOM)
   DTHETA=MAX(-0.02_q,MIN(0.02_q,-TARGET*BTRIAL*SQRT(SADDLE_P)))
   TARGET=-DTHETA/(BTRIAL*SQRT(SADDLE_P))
   SADDLE_STEP_KIND='BOOTSTRAP_RAW_G'
  ENDIF
  IF(TARGET*A>0._q) THEN
   TARGET=-A
   SADDLE_STEP_KIND='SIGN_REFLECT_FALLBACK'
  ENDIF
  IF(SADDLE_HISTORY.AND.SADDLE_G_RAW*SADDLE_PREV_G<0._q) THEN
   TARGET=-0.5_q*A
   SADDLE_STEP_KIND='ROOT_CROSS_DAMPED'
  ENDIF
  IF(ABS(TARGET)>2.5_q*ABS(A)) THEN
   TARGET=SIGN(2.5_q*ABS(A),TARGET)
   SADDLE_STEP_KIND='STEP_CAP_2P5'
  ENDIF
  SADDLE_PREV_G=SADDLE_G_RAW;SADDLE_PREV_THETA=SADDLE_THETA;SADDLE_HISTORY=.TRUE.
 ENDIF
 DO I=1,191
  DELTA=(TARGET-A)*SADDLE_V(I)
  CHF(I,192,1,2)=CHF(I,192,1,2)+DELTA
  CHF(192,I,1,2)=CHF(192,I,1,2)-DELTA
 ENDDO
 SADDLE_A_OUT=0
 DO I=1,191
  SADDLE_A_OUT=SADDLE_A_OUT+SADDLE_V(I)*REAL(CHF(I,192,1,2)+OV(192,I),q)
 ENDDO
 SADDLE_A_OUT=SADDLE_A_OUT/SADDLE_P
 IF(ABS(SADDLE_A_OUT-TARGET)>1E-10_q*MAX(1._q,ABS(TARGET))) &
  CALL vtutor%error('NTO_SADDLE: internal mode-map check failed')
 IF(IO%IU6>=0) WRITE(IO%IU6,'(A,I5,4ES18.9)') &
  'NTO_SADDLE direction n,a_in,a_out,norm,antierr ',NEL,SADDLE_A_IN,SADDLE_A_OUT,DNORM,ANTIERR
 DEALLOCATE(OV)
__GPU CALL OFFLOAD_ON_POP
GPACC !$ACC UPDATE DEVICE(CHF) IF(OFFLOAD_ON)
 END SUBROUTINE NTO_SADDLE_PROJECT

! Measure actual retracted tangent in the full PAW metric, before next iteration.
 SUBROUTINE NTO_SADDLE_MEASURE(W,WF,WDES,LATT_CUR,CQIJ,LMDIM,IO,NEL,BSTEP,EFERMI,NTRY,MAXTRY)
__GPU USE moffload
 USE prec
 USE base
 USE wave
 USE wave_high, ONLY: ELEMENTS
 USE lattice
 USE fileio, ONLY: OUTWAV
 USE choleski, ONLY: CALC_PAW_OVERLAP
 USE tutor, ONLY: vtutor
 USE, INTRINSIC :: ieee_arithmetic, ONLY: ieee_is_finite
 IMPLICIT NONE
 TYPE(wavespin) :: W,WF
 TYPE(wavedes) :: WDES
 TYPE(latt) :: LATT_CUR
 TYPE(wavedes1) :: WD1
 TYPE(in_struct) :: IO
 INTEGER :: LMDIM,NEL,I,J,NB,U,NTRY,MAXTRY
 REAL(q) :: BSTEP,EFERMI,ACTUAL,ERR
 CHARACTER(LEN=3) :: CHECK_EXT
 OVERLAP :: CQIJ(LMDIM,LMDIM,WDES%NIONS,WDES%NCDIJ)
 GDEF, ALLOCATABLE :: OV(:,:),ORTHO(:,:)
 LOGICAL,SAVE :: CREATED=.FALSE.
 IF(.NOT.SADDLE_W0_READY.OR.BSTEP<=0) CALL vtutor%error('NTO_SADDLE: no prior step for measurement')
GPACC !$ACC WAIT IF(OFFLOAD_ON)
GPACC !$ACC UPDATE SELF(W%CW,W%CPROJ,W%FERTOT,WF%CW,WF%CPROJ) IF(OFFLOAD_ON)
__GPU CALL OFFLOAD_ON_PUSH(.FALSE.)
 NB=WDES%NB_TOT;ALLOCATE(OV(NB,NB),ORTHO(NB,NB));CALL SETWDES(WDES,WD1,1)
 CALL CALC_PAW_OVERLAP(ELEMENTS(SADDLE_W0,WD1,2),ELEMENTS(W,WD1,2),CQIJ,OV)
 CALL CALC_PAW_OVERLAP(ELEMENTS(W,WD1,2),ELEMENTS(W,WD1,2),CQIJ,ORTHO)
 IF(NEL==1) THEN
  OPEN(NEWUNIT=U,FILE='NTO_SADDLE_OVL_001.csv',STATUS='REPLACE',ACTION='WRITE')
  DO I=1,NB
   WRITE(U,'(I0,*(",",ES24.16))') I,(REAL(OV(I,J),q),J=1,NB)
  ENDDO
  CLOSE(U)
 ENDIF
 ACTUAL=0;ERR=0
 DO I=1,191
  ACTUAL=ACTUAL+SADDLE_V(I)*REAL(OV(I,192),q)
 ENDDO
 ACTUAL=ACTUAL/(SADDLE_P*BSTEP)
 DO I=1,NB
  DO J=1,NB
   IF(I==J) THEN
    ERR=MAX(ERR,ABS(ORTHO(I,J)-1._q))
   ELSE
    ERR=MAX(ERR,ABS(ORTHO(I,J)))
   ENDIF
  ENDDO
 ENDDO
 IF(.NOT.ieee_is_finite(ACTUAL).OR..NOT.ieee_is_finite(ERR)) &
  CALL vtutor%error('NTO_SADDLE: nonfinite PAW step measurement')
 IF(ERR>1E-5_q) THEN
  CALL OUTWAV(IO,WDES,W,LATT_CUR,EFERMI,EXT='BAD')
  CALL vtutor%error('NTO_SADDLE: PAW orthogonality failed; WAVECAR.BAD saved')
 ENDIF
 SADDLE_ACTUAL=ACTUAL
 IF(.NOT.SADDLE_BEST_READY) THEN
  CALL ALLOCW(WDES,SADDLE_BEST_W);CALL ALLOCW(WDES,SADDLE_BEST_WF)
  SADDLE_BEST_READY=.TRUE.
 ENDIF
 IF(ABS(ACTUAL-SADDLE_A_OUT)<SADDLE_BEST_ERR) THEN
  SADDLE_BEST_ERR=ABS(ACTUAL-SADDLE_A_OUT);SADDLE_BEST_ACTUAL=ACTUAL
  SADDLE_BEST_ORTH=ERR;SADDLE_BEST_CORR=SADDLE_CORRECTION
  SADDLE_BEST_W%CW=W%CW;SADDLE_BEST_W%CPROJ=W%CPROJ;SADDLE_BEST_W%FERTOT=W%FERTOT
  SADDLE_BEST_WF%CW=WF%CW;SADDLE_BEST_WF%CPROJ=WF%CPROJ
 ENDIF
 IF(ABS(ACTUAL-SADDLE_A_OUT)>MAX(1E-6_q,0.01_q*ABS(SADDLE_A_OUT))) THEN
  IF(NTRY<MAXTRY) THEN
   DEALLOCATE(OV,ORTHO)
__GPU CALL OFFLOAD_ON_POP
   RETURN
  ELSE IF(SADDLE_BEST_ERR<5E-4_q) THEN
   W%CW=SADDLE_BEST_W%CW;W%CPROJ=SADDLE_BEST_W%CPROJ;W%FERTOT=SADDLE_BEST_W%FERTOT
   WF%CW=SADDLE_BEST_WF%CW;WF%CPROJ=SADDLE_BEST_WF%CPROJ
   ACTUAL=SADDLE_BEST_ACTUAL;SADDLE_ACTUAL=ACTUAL;ERR=SADDLE_BEST_ORTH
   SADDLE_CORRECTION=SADDLE_BEST_CORR;SADDLE_RELAXED=.TRUE.
   CALL CALC_PAW_OVERLAP(ELEMENTS(SADDLE_W0,WD1,2),ELEMENTS(W,WD1,2),CQIJ,OV)
   IF(IO%IU6>=0) WRITE(IO%IU6,'(A,ES18.9)') 'NTO_SADDLE relaxed best PAW mode deviation ',SADDLE_BEST_ERR
  ELSE
   CALL OUTWAV(IO,WDES,W,LATT_CUR,EFERMI,EXT='BAD')
   CALL vtutor%error('NTO_SADDLE: finite-step mode mismatch exceeds relaxed limit; WAVECAR.BAD saved')
  ENDIF
 ENDIF
 IF(SADDLE_MODE==3.AND.NEL>=2) THEN
  IF(REAL(OV(192,192),q)<0.5_q) THEN
   CALL OUTWAV(IO,WDES,W,LATT_CUR,EFERMI,EXT='BAD')
   CALL vtutor%error('NTO_SADDLE SECANT: hole orbital gauge discontinuity')
  ENDIF
  SADDLE_THETA=SADDLE_THETA-ACTUAL*BSTEP*SQRT(SADDLE_P)
 ENDIF
 IF(MOD(NEL,20)==0) THEN
  WRITE(CHECK_EXT,'(I3.3)') NEL
  CALL OUTWAV(IO,WDES,W,LATT_CUR,EFERMI,EXT=CHECK_EXT)
 ENDIF
 IF(SADDLE_H>0.1_q.AND..NOT.SADDLE_H_SAVED) THEN
  CALL OUTWAV(IO,WDES,W,LATT_CUR,EFERMI,EXT='HIT')
  SADDLE_H_SAVED=.TRUE.
 ENDIF
 IF(.NOT.CREATED) THEN
  OPEN(NEWUNIT=U,FILE='NTO_SADDLE_STEP.csv',STATUS='REPLACE',ACTION='WRITE')
  WRITE(U,'(A)') 'step,eta,TIME,a_before,a_after,actual_retracted_a,orthogonality_error,retry_count,mode_correction,step_kind,theta_cumulative,mode_deviation,relaxed_accept'
  CLOSE(U);CREATED=.TRUE.
 ENDIF
 OPEN(NEWUNIT=U,FILE='NTO_SADDLE_STEP.csv',STATUS='OLD',POSITION='APPEND',ACTION='WRITE')
 WRITE(U,'(I0,6(",",ES24.16),",",I0,",",ES24.16,",",A,2(",",ES24.16),",",L1)') &
  NEL,SADDLE_ETA,BSTEP,SADDLE_A_IN,SADDLE_A_OUT,ACTUAL,ERR,NTRY-1,SADDLE_CORRECTION, &
  TRIM(SADDLE_STEP_KIND),SADDLE_THETA,ABS(ACTUAL-SADDLE_A_OUT),SADDLE_RELAXED
 CLOSE(U)
 IF(IO%IU6>=0) WRITE(IO%IU6,'(A,I5,2ES18.9)') 'NTO_SADDLE measured n,a_actual,orth ',NEL,ACTUAL,ERR
 DEALLOCATE(OV,ORTHO)
__GPU CALL OFFLOAD_ON_POP
GPACC !$ACC UPDATE DEVICE(W%CW,W%CPROJ,W%FERTOT,WF%CW,WF%CPROJ) IF(OFFLOAD_ON)
 END SUBROUTINE NTO_SADDLE_MEASURE

! Re-evaluate only the algebraic orbital update, never the Hamiltonian or SCF.
! Restore both W and the incoming orbital velocity before adjusting the single
! CHF mode, then repeat the exact stock update/retraction (at most four times).
 SUBROUTINE NTO_SADDLE_RETRY(W,WF,WDES,CHF,IO,NEL)
__GPU USE moffload
 USE prec
 USE base
 USE wave
 USE tutor, ONLY: vtutor
 USE, INTRINSIC :: ieee_arithmetic, ONLY: ieee_is_finite
 IMPLICIT NONE
 TYPE(wavespin) :: W,WF
 TYPE(wavedes) :: WDES
 TYPE(in_struct) :: IO
 INTEGER :: NEL,I
 GDEF :: CHF(WDES%NB_TOT,WDES%NB_TOT,WDES%NKPTS,WDES%ISPIN)
 REAL(q) :: ERROR,DELTA
 ERROR=SADDLE_A_OUT-SADDLE_ACTUAL
 IF(.NOT.ieee_is_finite(ERROR)) CALL vtutor%error('NTO_SADDLE: nonfinite retry correction')
GPACC !$ACC WAIT IF(OFFLOAD_ON)
GPACC !$ACC UPDATE SELF(CHF) IF(OFFLOAD_ON)
__GPU CALL OFFLOAD_ON_PUSH(.FALSE.)
 W%CW=SADDLE_W0%CW;W%CPROJ=SADDLE_W0%CPROJ
 WF%CW=SADDLE_WF0%CW;WF%CPROJ=SADDLE_WF0%CPROJ
 DO I=1,191
  DELTA=SADDLE_V(I)*ERROR
  CHF(I,192,1,2)=CHF(I,192,1,2)+DELTA
  CHF(192,I,1,2)=CHF(192,I,1,2)-DELTA
 ENDDO
 SADDLE_CORRECTION=SADDLE_CORRECTION+ERROR
 IF(IO%IU6>=0) WRITE(IO%IU6,'(A,I5,3ES18.9)') &
  'NTO_SADDLE retry n,target,actual,correction ',NEL,SADDLE_A_OUT,SADDLE_ACTUAL,ERROR
__GPU CALL OFFLOAD_ON_POP
GPACC !$ACC UPDATE DEVICE(W%CW,W%CPROJ,WF%CW,WF%CPROJ,CHF) IF(OFFLOAD_ON)
 END SUBROUTINE NTO_SADDLE_RETRY

