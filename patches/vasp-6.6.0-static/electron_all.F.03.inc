      IF(SADDLE_MODE/=0.AND..NOT.SADDLE_STOP_EDIFF) INFO%LABORT=.FALSE.
      IF(SADDLE_MODE==3) THEN
        IF(N==1) SADDLE_STABLE_COUNT=0
        IF(ABS(SADDLE_G_RAW)<=SADDLE_STOP_G .AND. &
          (SADDLE_RPERP_EST<=SADDLE_STOP_REST.AND.SADDLE_RPERP_SUB<=SADDLE_STOP_RSUB) .AND. &
          ABS(DESUM(N))<=SADDLE_STOP_DE.AND.SADDLE_H<SADDLE_STOP_H.AND. &
          SADDLE_P>SADDLE_STOP_P.AND.SADDLE_C_ABS<SADDLE_STOP_C) THEN
          SADDLE_STABLE_COUNT=SADDLE_STABLE_COUNT+1
        ELSE
          SADDLE_STABLE_COUNT=0
        ENDIF
        IF(N>=SADDLE_STOP_MIN_STEP.AND.SADDLE_STABLE_COUNT>=SADDLE_STOP_STEPS) THEN
          INFO%LABORT=.TRUE.
          IF(IO%IU6>=0) WRITE(IO%IU6,'(A,I0,A,I0)') &
            'NTO_SADDLE estimated residual criterion reached step=',N,' stable=',SADDLE_STABLE_COUNT
        ENDIF
      ENDIF
