      IF(SADDLE_MODE/=0.AND..NOT.SADDLE_STOP_EDIFF) INFO%LABORT=.FALSE.
      IF(SADDLE_MODE==3) THEN
        SADDLE_IONIC_ACCEPTED=.FALSE.
        IF(SADDLE_STEP_INDEX==1) THEN
          SADDLE_STABLE_COUNT=0
          SADDLE_IONIC_ACCEPTED=.FALSE.
        ENDIF
        IF(ABS(SADDLE_G_RAW)<=SADDLE_STOP_G .AND. &
          (SADDLE_RPERP_SUB<=SADDLE_STOP_RSUB.AND. &
           ((SADDLE_FAST.AND..NOT.SADDLE_FULL_DIAG).OR.SADDLE_RPERP_EST<=SADDLE_STOP_REST)) .AND. &
          ABS(DESUM(N))<=SADDLE_STOP_DE.AND.SADDLE_H<NTO_SADDLE_H_LIMIT().AND. &
          SADDLE_P>NTO_SADDLE_P_LIMIT().AND.SADDLE_C_ABS<NTO_SADDLE_C_LIMIT()) THEN
          SADDLE_STABLE_COUNT=SADDLE_STABLE_COUNT+1
        ELSE
          SADDLE_STABLE_COUNT=0
        ENDIF
        IF(SADDLE_STEP_INDEX>=NTO_SADDLE_MIN_STEP().AND.SADDLE_STABLE_COUNT>=NTO_SADDLE_STREAK()) THEN
          INFO%LABORT=.TRUE.
          SADDLE_IONIC_ACCEPTED=.TRUE.
          IF(IO%IU6>=0) WRITE(IO%IU6,'(A,I0,A,I0)') &
            'NTO_SADDLE estimated residual criterion reached step=',N,' stable=',SADDLE_STABLE_COUNT
        ENDIF
      ENDIF
      SADDLE_NELMIN_SAVE=INFO%NELMIN
      IF(SADDLE_FAST.AND.SADDLE_IONIC_FOLLOW.AND.SADDLE_IONIC_INDEX>=2) &
        INFO%NELMIN=MIN(ABS(INFO%NELMIN),SADDLE_ION_MIN)
