! S1 diagnostic only. Full PAW overlap; no changes to orbitals or occupations.
! This reports EDWAV's actual applied-H subspace residual, not a full-space
! residual and not proof that local density and exchange derive from same P.
 SUBROUTINE NTO_SADDLE_TRACE(W,WDES,LATT_CUR,CQIJ,LMDIM,NONLR_S,NONL_S,IO,CHAM,NEL,IROT,IFLAG,BTRIAL,EFERMI,LCHCON)
__GPU USE moffload
 USE prec
 USE base
 USE wave
 USE wave_high, ONLY: ELEMENTS
 USE lattice
 USE nonl_struct_def
 USE nonlr_struct_def
 USE nonl_high, ONLY: PROALL
 USE fileio, ONLY: INWAV_ALTERNATIVE,OUTWAV
 USE choleski, ONLY: CALC_PAW_OVERLAP
 USE fock_ace, ONLY: LFOCK_ACE
 USE tutor, ONLY: vtutor
 IMPLICIT NONE
 TYPE(wavespin) :: W
 TYPE(wavedes) :: WDES
 TYPE(latt) :: LATT_CUR
 TYPE(nonlr_struct) :: NONLR_S
 TYPE(nonl_struct) :: NONL_S
 TYPE(in_struct) :: IO
 INTEGER :: LMDIM,NEL,IROT,IFLAG
 REAL(q) :: BTRIAL,EFERMI
 OVERLAP :: CQIJ(LMDIM,LMDIM,WDES%NIONS,WDES%NCDIJ)
 GDEF :: CHAM(WDES%NB_TOT,WDES%NB_TOT,WDES%NKPTS,WDES%ISPIN)
 TYPE(wavedes1) :: WD1
 LOGICAL,SAVE :: INIT=.FALSE., ENABLED=.FALSE.
 LOGICAL :: EXISTS,LREAD,ACEACTIVE,STOP_ENERGY_ONLY,LCHCON
 INTEGER :: U,IOS,I,J,NB,SPIN,HOLE,NOCC,EVERY,RH,RP
 CHARACTER(LEN=512) :: LINE,KEY,VALUE
 CHARACTER(LEN=32),SAVE :: MODE='OFF'
 CHARACTER(LEN=8) :: ACESTR,FOCKSTR,ACEUSED
 GDEF,ALLOCATABLE :: C(:,:)
 REAL(q) :: H,P,COH,CMAX,LH,LP,GM,RSUB,RPERP,HOLEWEIGHT,INPUT_ETA,REXT,REST_TOTAL,REST_PERP
 IF (.NOT.INIT) THEN
  INIT=.TRUE.
  INQUIRE(FILE='NTO_SADDLE',EXIST=EXISTS)
  IF (.NOT.EXISTS) RETURN
  SPIN=2;HOLE=0;NOCC=-1;RH=0;RP=0;EVERY=1;STOP_ENERGY_ONLY=.TRUE.;INPUT_ETA=1._q
  OPEN(NEWUNIT=U,FILE='NTO_SADDLE',STATUS='OLD',ACTION='READ',IOSTAT=IOS)
  IF (IOS/=0) CALL vtutor%error('NTO_SADDLE: cannot open configuration')
  DO
   READ(U,'(A)',IOSTAT=IOS) LINE
   IF (IOS<0) EXIT
   IF (IOS/=0) CALL vtutor%error('NTO_SADDLE: configuration read error')
   LINE=ADJUSTL(LINE)
   IF (LEN_TRIM(LINE)==0.OR.LINE(1:1)=='#') CYCLE
   READ(LINE,*,IOSTAT=IOS) KEY,VALUE
   IF (IOS/=0) CALL vtutor%error('NTO_SADDLE: expected key and value')
   SELECT CASE(TRIM(KEY))
   CASE('TRUST_C')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_TRUST_C
   CASE('TRUST_C_MAX')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_TRUST_MAX
   CASE('IONIC_STOP_H_MAX')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_ION_H_MAX
   CASE('IONIC_STOP_P_MIN')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_ION_P_MIN
   CASE('IONIC_STOP_C_MAX')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_ION_C_MAX
   CASE('IONIC_TIME')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_ION_TIME
   CASE('IONIC_N_PROJECT')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_ION_NPROJECT
   CASE('IONIC_N_REFLECT')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_ION_NREFLECT
   CASE('FAST_PATH')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_FAST
   CASE('TRACE_FULL_DIAG')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_FULL_DIAG
   CASE('IONIC_MIN_STEP')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_ION_MIN
   CASE('IONIC_STABLE_STEPS')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_ION_STABLE
   CASE('IONIC_FOLLOW')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_IONIC_FOLLOW
   CASE('MODE')
    MODE=TRIM(VALUE)
   CASE('SPIN')
    READ(VALUE,*,IOSTAT=IOS) SPIN
   CASE('HOLE_BAND')
    READ(VALUE,*,IOSTAT=IOS) HOLE
   CASE('N_OCC','N_OCC_BETA')
    IF(TRIM(VALUE)=='AUTO') THEN
     NOCC=-1
    ELSE
     READ(VALUE,*,IOSTAT=IOS) NOCC
    ENDIF
   CASE('REF_HOLE_BAND')
    READ(VALUE,*,IOSTAT=IOS) RH
   CASE('REF_PART_BAND')
    READ(VALUE,*,IOSTAT=IOS) RP
   CASE('N_PROJECT')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_NPROJECT
   CASE('N_REFLECT')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_NREFLECT
   CASE('PRINT_EVERY')
    READ(VALUE,*,IOSTAT=IOS) EVERY
   CASE('ETA')
    READ(VALUE,*,IOSTAT=IOS) INPUT_ETA
   CASE('STOP_G_MODE_MAX')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_STOP_G
   CASE('STOP_RPERP_EST_MAX')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_STOP_REST
   CASE('STOP_RPERP_SUB_MAX')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_STOP_RSUB
   CASE('STOP_DE_MAX')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_STOP_DE
   CASE('STOP_H_MAX')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_STOP_H
   CASE('STOP_P_MIN')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_STOP_P
   CASE('STOP_C_ABS_MAX','STOP_C_MAX')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_STOP_C
   CASE('STOP_MIN_STEP')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_STOP_MIN_STEP
   CASE('STOP_STABLE_STEPS')
    READ(VALUE,*,IOSTAT=IOS) SADDLE_STOP_STEPS
   CASE('STOP_ON_EDIFF_ONLY')
    READ(VALUE,*,IOSTAT=IOS) STOP_ENERGY_ONLY
   CASE DEFAULT
    CALL vtutor%error('NTO_SADDLE: unknown configuration key')
   END SELECT
   IF (IOS/=0) CALL vtutor%error('NTO_SADDLE: invalid parameter')
  ENDDO
  CLOSE(U)
  IF(SADDLE_TRUST_MAX<=0._q.OR.SADDLE_TRUST_MAX>=0.5_q.OR. &
     MIN(SADDLE_ION_H_MAX,SADDLE_ION_P_MIN,SADDLE_ION_C_MAX,SADDLE_ION_TIME)<=0._q.OR. &
     MAX(SADDLE_ION_H_MAX,SADDLE_ION_P_MIN,SADDLE_ION_C_MAX)>=1._q.OR. &
     SADDLE_ION_NPROJECT<0.OR.SADDLE_ION_NREFLECT<0) &
   CALL vtutor%error('NTO_SADDLE: invalid trust or ionic runtime settings')
  IF(SADDLE_ION_MIN<2.OR.SADDLE_ION_STABLE<1) &
   CALL vtutor%error('NTO_SADDLE: invalid ionic stopping counts')
  IF (MIN(SADDLE_STOP_G,SADDLE_STOP_REST,SADDLE_STOP_RSUB, &
      SADDLE_STOP_DE,SADDLE_STOP_H,SADDLE_STOP_P,SADDLE_STOP_C)<=0._q.OR. &
      SADDLE_STOP_H>=1._q.OR.SADDLE_STOP_P>=1._q.OR. &
      SADDLE_STOP_MIN_STEP<2.OR.SADDLE_STOP_STEPS<1) &
   CALL vtutor%error('NTO_SADDLE: invalid runtime stop thresholds')
  IF(IO%IU6>=0) THEN
   WRITE(IO%IU6,'(A)') 'NTO_SADDLE runtime stop policy r2 (raw estimated residual)'
   WRITE(IO%IU6,'(A,ES24.16)') 'STOP_G_MODE_MAX = ',SADDLE_STOP_G
   WRITE(IO%IU6,'(A,ES24.16)') 'STOP_RPERP_EST_MAX = ',SADDLE_STOP_REST
   WRITE(IO%IU6,'(A,ES24.16)') 'STOP_RPERP_SUB_MAX = ',SADDLE_STOP_RSUB
   WRITE(IO%IU6,'(A,ES24.16)') 'STOP_DE_MAX = ',SADDLE_STOP_DE
   WRITE(IO%IU6,'(A,ES24.16)') 'STOP_H_MAX = ',SADDLE_STOP_H
   WRITE(IO%IU6,'(A,ES24.16)') 'STOP_P_MIN = ',SADDLE_STOP_P
   WRITE(IO%IU6,'(A,ES24.16)') 'STOP_C_ABS_MAX = ',SADDLE_STOP_C
   WRITE(IO%IU6,'(A,2I8)') 'STOP_MIN_STEP,STOP_STABLE_STEPS = ',SADDLE_STOP_MIN_STEP,SADDLE_STOP_STEPS
  ENDIF
  SELECT CASE(TRIM(MODE))
  CASE('AUTO')
   SADDLE_AUTO=.TRUE.;SADDLE_MODE=1;SADDLE_ETA=0._q
  CASE('OFF')
   SADDLE_MODE=0;SADDLE_ETA=1._q
   IF (.NOT.STOP_ENERGY_ONLY) CALL vtutor%error('NTO_SADDLE OFF: residual stop rule not implemented')
  CASE('PROJECT')
   SADDLE_MODE=1;SADDLE_ETA=0._q
   IF (ABS(INPUT_ETA)>1E-12_q) CALL vtutor%error('NTO_SADDLE PROJECT requires ETA 0')
  CASE('REFLECT')
   SADDLE_MODE=2;SADDLE_ETA=-1._q
   IF (ABS(INPUT_ETA+1._q)>1E-12_q) CALL vtutor%error('NTO_SADDLE REFLECT requires ETA -1')
  CASE('SECANT')
   SADDLE_MODE=3;SADDLE_ETA=-1._q
   IF (ABS(INPUT_ETA+1._q)>1E-12_q) CALL vtutor%error('NTO_SADDLE SECANT requires ETA -1')
  CASE DEFAULT
   CALL vtutor%error('NTO_SADDLE: unsupported mode')
  END SELECT
  IF(SADDLE_IONIC_FOLLOW.AND..NOT.(SADDLE_MODE==3.OR.SADDLE_AUTO)) &
   CALL vtutor%error('NTO_SADDLE: IONIC_FOLLOW requires SECANT or AUTO')
  SADDLE_STOP_EDIFF=STOP_ENERGY_ONLY
  IF (SADDLE_MODE/=0.AND.STOP_ENERGY_ONLY) &
   CALL vtutor%error('NTO_SADDLE: PROJECT/REFLECT must disable energy-only stopping')
  IF (WDES%COMM%NCPU/=1.OR.WDES%NKPTS/=1.OR.WDES%ISPIN/=2.OR.SPIN/=2.OR.EVERY/=1) &
   CALL vtutor%error('NTO_SADDLE: requires one MPI rank, Gamma, two spins, beta mode and PRINT_EVERY=1')
  IF(NOCC==-1) NOCC=COUNT(W%FERTOT(:,1,2)>0.5_q)
  IF(HOLE==0) HOLE=NOCC+1
  IF(RH==0) RH=NOCC
  IF(RP==0) RP=NOCC+1
  IF(NOCC<1.OR.NOCC>=WDES%NB_TOT.OR.HOLE<=NOCC.OR.HOLE>WDES%NB_TOT.OR. &
     RH<1.OR.RH>NOCC.OR.RP<=NOCC.OR.RP>WDES%NB_TOT.OR. &
     SADDLE_NPROJECT<0.OR.SADDLE_NREFLECT<0) &
   CALL vtutor%error('NTO_SADDLE: invalid occupied count, reference indices, empty hole or AUTO schedule')
  SADDLE_NOCC=NOCC;SADDLE_Q=HOLE;SADDLE_RH=RH;SADDLE_RP=RP
  IF(SADDLE_IONIC_FOLLOW.AND..NOT.SADDLE_IONIC_HOOKS) &
   CALL vtutor%error('NTO_SADDLE: ionic-experimental main-loop hooks required for IONIC_FOLLOW')
  IF(IO%IU6>=0) WRITE(IO%IU6,'(A,5I8)') &
   'NTO_SADDLE dimensions NBANDS,N_OCC_BETA,HOLE_BAND,REF_HOLE_BAND,REF_PART_BAND = ', &
   WDES%NB_TOT,NOCC,HOLE,RH,RP
#ifndef wNGXhalf
#ifndef wNGZhalf
  CALL vtutor%error('NTO_SADDLE S1: requires Gamma-real binary')
#endif
#endif
__GPU CALL OFFLOAD_ON_PUSH(.FALSE.)
  CALL INWAV_ALTERNATIVE(IO,WDES,SADDLE_REF,WDES%GRID,LATT_CUR,LREAD,'qqq')
  IF (.NOT.LREAD) CALL vtutor%error('NTO_SADDLE S1: missing WAVECAR.qqq reference')
  CALL PROALL(WDES%GRID,LATT_CUR,NONLR_S,NONL_S,SADDLE_REF)
  SADDLE_REF_READY=.TRUE.
__GPU CALL OFFLOAD_ON_POP
  OPEN(NEWUNIT=U,FILE='NTO_SADDLE_TRACE.csv',STATUS='REPLACE',ACTION='WRITE')
  WRITE(U,'(A)') 'ionic_step,step,iflag,mode,eta,TIME,h,p,c_re,c_abs,c_over_cmax,ell_h,ell_p,'// &
   'p_occ_norm,hole_weight,ferdo_occ_last,ferdo_hole,g_mode_re,R_mode,R_perp_subspace,R_subspace,'// &
   'R_external_raw_PAW,R_perp_est_normalized,R_total_est_normalized,'// &
   'rot_path,Fock_action_kind,ACE_active,ACE_feature_enabled,stop_rule,full_residual'
  CLOSE(U)
  ENABLED=.TRUE.
  IF(IO%IU6>=0) WRITE(IO%IU6,'(A)') &
   'NTO_SADDLE: applied-H subspace diagnostic; full residual and final acceptance MISSING'
 ENDIF
 IF (.NOT.ENABLED) RETURN
 CALL NTO_SADDLE_SCHEDULE(NEL,IO)
 IF(IFLAG==2) RETURN
 IF (IROT/=3) CALL vtutor%error('NTO_SADDLE S1: unsupported IROT; no untracked rotation allowed')
 IF(SADDLE_FAST) THEN
  CALL NTO_FAST_TRACE(W,WDES,LATT_CUR,CQIJ,LMDIM,IO,CHAM,NEL,IFLAG,BTRIAL,EFERMI,LCHCON)
  RETURN
 ENDIF
 ACEACTIVE=LFOCK_ACE()
GPACC !$ACC WAIT IF(OFFLOAD_ON)
GPACC !$ACC UPDATE SELF(W%CW,W%CPROJ,W%FERTOT,CHAM) IF(OFFLOAD_ON)
__GPU CALL OFFLOAD_ON_PUSH(.FALSE.)
 NB=WDES%NB_TOT
 ALLOCATE(C(NB,NB))
 CALL SETWDES(WDES,WD1,1)
 CALL CALC_PAW_OVERLAP(ELEMENTS(W,WD1,2),ELEMENTS(SADDLE_REF,WD1,2),CQIJ,C)
 IF (MAXVAL(ABS(W%FERTOT(1:SADDLE_NOCC,1,2)-1._q))>1E-7_q.OR. &
     MAXVAL(ABS(W%FERTOT(SADDLE_NOCC+1:NB,1,2)))>1E-7_q) &
  CALL vtutor%error('NTO_SADDLE S1: unexpected FERDO')
 H=SUM(ABS(C(1:SADDLE_NOCC,SADDLE_RH))**2)
 P=SUM(ABS(C(1:SADDLE_NOCC,SADDLE_RP))**2)
 COH=REAL(SUM(C(1:SADDLE_NOCC,SADDLE_RH)*GCONJG(C(1:SADDLE_NOCC,SADDLE_RP))),q)
 HOLEWEIGHT=ABS(C(SADDLE_Q,SADDLE_RH))**2
 CMAX=SQRT(MAX(0._q,MIN(H*(1-H),P*(1-P))))
 LH=H*(1-H)-COH*COH; LP=P*(1-P)-COH*COH
 IF(P<=1E-14_q) CALL vtutor%error('NTO_SADDLE: particle projection is zero')
 IF(SADDLE_MODE/=0) THEN
  IF(P<0.5_q.OR.HOLEWEIGHT<0.5_q) THEN
   CALL OUTWAV(IO,WDES,W,LATT_CUR,EFERMI,EXT='BAD')
   CALL vtutor%error('NTO_SADDLE: NTO mode identity lost; WAVECAR.BAD saved')
  ENDIF
  IF(.NOT.ALLOCATED(SADDLE_V)) ALLOCATE(SADDLE_V(SADDLE_NOCC))
  SADDLE_V=REAL(C(1:SADDLE_NOCC,SADDLE_RP),q);SADDLE_P=P;SADDLE_H=H;SADDLE_C_ABS=ABS(COH)
 ENDIF
 GM=0
 DO I=1,SADDLE_NOCC
  GM=GM+REAL(CHAM(SADDLE_Q,I,1,2)*C(I,SADDLE_RP),q)/SQRT(P)
 ENDDO
 SADDLE_G_RAW=GM
 ! Positive scalar made from stock ROTINI's orbital gaps and its EH=0.35
 ! response factor. Used only when SECANT must bootstrap a vanished mode.
 SADDLE_DENOM=0._q
 DO I=1,SADDLE_NOCC
  SADDLE_DENOM=SADDLE_DENOM+REAL(C(I,SADDLE_RP),q)**2* &
       (ABS(REAL(CHAM(SADDLE_Q,SADDLE_Q,1,2)-CHAM(I,I,1,2),q))+MERGE(0._q,1.4_q,LCHCON))
 ENDDO
 SADDLE_DENOM=SADDLE_DENOM/P
 RSUB=0
 DO I=1,SADDLE_NOCC
  DO J=SADDLE_NOCC+1,NB
   RSUB=RSUB+ABS(CHAM(J,I,1,2))**2
  ENDDO
 ENDDO
 RPERP=SQRT(MAX(0._q,RSUB-GM*GM));RSUB=SQRT(RSUB)
 REXT=SQRT(MAX(0._q,SADDLE_RAW_EXT2))
 REST_PERP=SQRT((RPERP**2+REXT**2)/REAL(SADDLE_NOCC,q));REST_TOTAL=SQRT((RSUB**2+REXT**2)/REAL(SADDLE_NOCC,q))
 SADDLE_RPERP_EST=REST_PERP;SADDLE_RPERP_SUB=RPERP
 ACESTR='F'
 IF(ACEACTIVE) ACESTR='T'
#ifdef fock_dblbuf
 ! EDWAV directly calls FOCK_ALL_DBLBUF; LFOCK_ACE only reports availability.
 FOCKSTR='full';ACEUSED='F'
#else
 FOCKSTR='MISSING';ACEUSED='MISSING'
#endif
 OPEN(NEWUNIT=U,FILE='NTO_SADDLE_TRACE.csv',STATUS='OLD',POSITION='APPEND',ACTION='WRITE')
 WRITE(U,'(I0,",",I0,",",I0,",",A,",",ES24.16,",",ES24.16,18(",",ES24.16),",EDWAV+IROT3,",A,",",A,",",A,",MISSING,MISSING")') &
  SADDLE_IONIC_INDEX,NEL,IFLAG,TRIM(NTO_SADDLE_MODE_NAME()),SADDLE_ETA,BTRIAL,H,P,COH,ABS(COH),MERGE(ABS(COH)/MAX(CMAX,TINY(CMAX)),0._q,CMAX>0),LH,LP, &
  P,HOLEWEIGHT,W%FERTOT(SADDLE_NOCC,1,2),W%FERTOT(SADDLE_Q,1,2),GM,ABS(GM),RPERP,RSUB,REXT,REST_PERP,REST_TOTAL,TRIM(FOCKSTR),TRIM(ACEUSED),TRIM(ACESTR)
 CLOSE(U)
 IF(IO%IU6>=0) WRITE(IO%IU6,'(A,I5,A,5ES18.9)') &
  'NTO_SADDLE S1 n=',NEL,' h,p,c,g_mode,R_subspace ',H,P,COH,GM,RSUB
 DEALLOCATE(C)
__GPU CALL OFFLOAD_ON_POP
 END SUBROUTINE NTO_SADDLE_TRACE

! Experimental IROT=3 one-mode map, Gamma-real / one MPI only.
! CHF is not the PAW tangent by itself. Include the PAW projection of W_F;
! ROT2 uses its upper triangle and ORTHCH supplies the corresponding lower.
 SUBROUTINE NTO_SADDLE_PROJECT(W,WF,WDES,LATT_CUR,CQIJ,LMDIM,CHF,IO,NEL,IROT,EFERMI,BTRIAL)
__GPU USE moffload
 USE prec
 USE base
 USE wave
 USE wave_high, ONLY: ELEMENTS
 USE lattice
 USE fileio, ONLY: OUTWAV
 USE choleski, ONLY: CALC_PAW_OVERLAP
 USE tutor, ONLY: vtutor
 USE, INTRINSIC :: ieee_arithmetic, ONLY: ieee_is_finite
 IMPLICIT NONE
 TYPE(wavespin) :: W,WF
 TYPE(wavedes) :: WDES
 TYPE(latt) :: LATT_CUR
 TYPE(wavedes1) :: WD1
 TYPE(in_struct) :: IO
 INTEGER :: LMDIM,NEL,IROT,I,J,NB
 OVERLAP :: CQIJ(LMDIM,LMDIM,WDES%NIONS,WDES%NCDIJ)
 GDEF :: CHF(WDES%NB_TOT,WDES%NB_TOT,WDES%NKPTS,WDES%ISPIN)
 GDEF, ALLOCATABLE :: OV(:,:)
 REAL(q) :: DI,A,DELTA,ANTIERR,DNORM,EFERMI,BTRIAL,TARGET,DTHETA,DG,DT
 IF(SADDLE_FAST) THEN
  CALL NTO_FAST_PROJECT(W,WF,WDES,CQIJ,CHF,IO,NEL,IROT,BTRIAL)
  RETURN
 ENDIF
 IF(IROT/=3.OR..NOT.ALLOCATED(SADDLE_V)) CALL vtutor%error('NTO_SADDLE: unsupported step path')
GPACC !$ACC WAIT IF(OFFLOAD_ON)
GPACC !$ACC UPDATE SELF(W%CW,W%CPROJ,W%FERTOT,WF%CW,WF%CPROJ,CHF) IF(OFFLOAD_ON)
__GPU CALL OFFLOAD_ON_PUSH(.FALSE.)
 NB=WDES%NB_TOT
 IF(.NOT.SADDLE_W0_READY) THEN
  CALL ALLOCW(WDES,SADDLE_W0)
  CALL ALLOCW(WDES,SADDLE_WF0)
  SADDLE_W0_READY=.TRUE.
 ENDIF
 SADDLE_W0%CW=W%CW;SADDLE_W0%CPROJ=W%CPROJ;SADDLE_W0%FERTOT=W%FERTOT
 SADDLE_WF0%CW=WF%CW;SADDLE_WF0%CPROJ=WF%CPROJ
 SADDLE_CORRECTION=0._q;SADDLE_BEST_ERR=HUGE(1._q);SADDLE_RELAXED=.FALSE.
 ALLOCATE(OV(NB,NB));CALL SETWDES(WDES,WD1,1)
 CALL CALC_PAW_OVERLAP(ELEMENTS(W,WD1,2),ELEMENTS(WF,WD1,2),CQIJ,OV)
 A=0;ANTIERR=0;DNORM=0
 DO I=1,SADDLE_NOCC
  DI=REAL(CHF(I,SADDLE_Q,1,2)+OV(SADDLE_Q,I),q)
  A=A+SADDLE_V(I)*DI
  ANTIERR=MAX(ANTIERR,ABS(REAL(CHF(I,SADDLE_Q,1,2)+CHF(SADDLE_Q,I,1,2),q)))
  DO J=SADDLE_NOCC+1,NB
   DNORM=DNORM+ABS(CHF(I,J,1,2)+OV(J,I))**2
  ENDDO
 ENDDO
 A=A/SADDLE_P;DNORM=SQRT(DNORM)
 IF(SADDLE_MODE==2.AND.NEL>=2.AND.ABS(SADDLE_G_RAW)>1E-5_q.AND.ABS(A)<1E-10_q) THEN
  CALL OUTWAV(IO,WDES,W,LATT_CUR,EFERMI,EXT='BAD')
  CALL vtutor%error('NTO_SADDLE REFLECT: raw mode gradient nonzero but step direction vanished; WAVECAR.BAD saved')
 ENDIF
 IF(.NOT.ieee_is_finite(A).OR..NOT.ieee_is_finite(DNORM)) &
  CALL vtutor%error('NTO_SADDLE: nonfinite step')
 IF(ANTIERR>1E-7_q) CALL vtutor%error('NTO_SADDLE: CHF anti-symmetry unsupported')
 SADDLE_A_IN=A
 TARGET=SADDLE_ETA*A;SADDLE_STEP_KIND='REFLECT_FALLBACK'
 IF(SADDLE_MODE==1) SADDLE_STEP_KIND='PROJECT'
 IF(SADDLE_MODE==2) SADDLE_STEP_KIND='REFLECT'
 IF(NEL==1) THEN
  ! Initial SDA step: project the mode for every active optimizer; do not
  ! bootstrap, reflect, or store secant history until the following step.
  TARGET=0._q;SADDLE_STEP_KIND='INITIAL_PROJECT'
 ELSE IF(SADDLE_MODE==3) THEN
  IF(SADDLE_HISTORY) THEN
   DG=SADDLE_G_RAW-SADDLE_PREV_G;DT=SADDLE_THETA-SADDLE_PREV_THETA
   IF(ABS(DG)>1E-8_q.AND.ABS(DT)>1E-10_q) THEN
    DTHETA=-0.35_q*SADDLE_G_RAW*DT/DG
    DTHETA=MAX(-0.02_q,MIN(0.02_q,DTHETA))
    TARGET=-DTHETA/(BTRIAL*SQRT(SADDLE_P))
    SADDLE_STEP_KIND='SECANT'
   ENDIF
  ENDIF
  IF(SADDLE_STEP_KIND=='REFLECT_FALLBACK'.AND.ABS(TARGET)<1E-10_q.AND.ABS(SADDLE_G_RAW)>1E-5_q) THEN
   IF(SADDLE_DENOM<=1E-8_q.OR..NOT.ieee_is_finite(SADDLE_DENOM)) &
    CALL vtutor%error('NTO_SADDLE SECANT: invalid bootstrap denominator')
   TARGET=-SADDLE_G_RAW/(SQRT(SADDLE_P)*SADDLE_DENOM)
   DTHETA=MAX(-0.02_q,MIN(0.02_q,-TARGET*BTRIAL*SQRT(SADDLE_P)))
   TARGET=-DTHETA/(BTRIAL*SQRT(SADDLE_P))
   SADDLE_STEP_KIND='BOOTSTRAP_RAW_G'
  ENDIF
  IF(TARGET*A>0._q) THEN
   TARGET=-A
   SADDLE_STEP_KIND='SIGN_REFLECT_FALLBACK'
  ENDIF
  IF(SADDLE_HISTORY.AND.SADDLE_G_RAW*SADDLE_PREV_G<0._q) THEN
   TARGET=-0.5_q*A
   SADDLE_STEP_KIND='ROOT_CROSS_DAMPED'
  ENDIF
  IF(ABS(TARGET)>2.5_q*ABS(A)) THEN
   TARGET=SIGN(2.5_q*ABS(A),TARGET)
   SADDLE_STEP_KIND='STEP_CAP_2P5'
  ENDIF
  SADDLE_PREV_G=SADDLE_G_RAW;SADDLE_PREV_THETA=SADDLE_THETA;SADDLE_HISTORY=.TRUE.
 ENDIF
 DO I=1,SADDLE_NOCC
  DELTA=(TARGET-A)*SADDLE_V(I)
  CHF(I,SADDLE_Q,1,2)=CHF(I,SADDLE_Q,1,2)+DELTA
  CHF(SADDLE_Q,I,1,2)=CHF(SADDLE_Q,I,1,2)-DELTA
 ENDDO
 SADDLE_A_OUT=0
 DO I=1,SADDLE_NOCC
  SADDLE_A_OUT=SADDLE_A_OUT+SADDLE_V(I)*REAL(CHF(I,SADDLE_Q,1,2)+OV(SADDLE_Q,I),q)
 ENDDO
 SADDLE_A_OUT=SADDLE_A_OUT/SADDLE_P
 IF(ABS(SADDLE_A_OUT-TARGET)>1E-10_q*MAX(1._q,ABS(TARGET))) &
  CALL vtutor%error('NTO_SADDLE: internal mode-map check failed')
 IF(IO%IU6>=0) WRITE(IO%IU6,'(A,I5,4ES18.9)') &
  'NTO_SADDLE direction n,a_in,a_out,norm,antierr ',NEL,SADDLE_A_IN,SADDLE_A_OUT,DNORM,ANTIERR
 DEALLOCATE(OV)
__GPU CALL OFFLOAD_ON_POP
GPACC !$ACC UPDATE DEVICE(CHF) IF(OFFLOAD_ON)
 END SUBROUTINE NTO_SADDLE_PROJECT

! Measure actual retracted tangent in the full PAW metric, before next iteration.
 SUBROUTINE NTO_SADDLE_MEASURE(W,WF,WDES,LATT_CUR,CQIJ,LMDIM,IO,NEL,BSTEP,EFERMI,NTRY,MAXTRY)
__GPU USE moffload
 USE prec
 USE base
 USE wave
 USE wave_high, ONLY: ELEMENTS
 USE lattice
 USE fileio, ONLY: OUTWAV
 USE choleski, ONLY: CALC_PAW_OVERLAP
 USE tutor, ONLY: vtutor
 USE, INTRINSIC :: ieee_arithmetic, ONLY: ieee_is_finite
 IMPLICIT NONE
 TYPE(wavespin) :: W,WF
 TYPE(wavedes) :: WDES
 TYPE(latt) :: LATT_CUR
 TYPE(wavedes1) :: WD1
 TYPE(in_struct) :: IO
 INTEGER :: LMDIM,NEL,I,J,NB,U,NTRY,MAXTRY
 REAL(q) :: BSTEP,EFERMI,ACTUAL,ERR
 CHARACTER(LEN=3) :: CHECK_EXT
 OVERLAP :: CQIJ(LMDIM,LMDIM,WDES%NIONS,WDES%NCDIJ)
 GDEF, ALLOCATABLE :: OV(:,:),ORTHO(:,:)
 LOGICAL,SAVE :: CREATED=.FALSE.
 IF(SADDLE_FAST) THEN
  CALL NTO_FAST_MEASURE(W,WF,WDES,LATT_CUR,CQIJ,IO,NEL,BSTEP,EFERMI)
  RETURN
 ENDIF
 IF(.NOT.SADDLE_W0_READY.OR.BSTEP<=0) CALL vtutor%error('NTO_SADDLE: no prior step for measurement')
GPACC !$ACC WAIT IF(OFFLOAD_ON)
GPACC !$ACC UPDATE SELF(W%CW,W%CPROJ,W%FERTOT,WF%CW,WF%CPROJ) IF(OFFLOAD_ON)
__GPU CALL OFFLOAD_ON_PUSH(.FALSE.)
 NB=WDES%NB_TOT;ALLOCATE(OV(NB,NB),ORTHO(NB,NB));CALL SETWDES(WDES,WD1,1)
 CALL CALC_PAW_OVERLAP(ELEMENTS(SADDLE_W0,WD1,2),ELEMENTS(W,WD1,2),CQIJ,OV)
 CALL CALC_PAW_OVERLAP(ELEMENTS(W,WD1,2),ELEMENTS(W,WD1,2),CQIJ,ORTHO)
 IF(NEL==1) THEN
  OPEN(NEWUNIT=U,FILE='NTO_SADDLE_OVL_001.csv',STATUS='REPLACE',ACTION='WRITE')
  DO I=1,NB
   WRITE(U,'(I0,*(",",ES24.16))') I,(REAL(OV(I,J),q),J=1,NB)
  ENDDO
  CLOSE(U)
 ENDIF
 ACTUAL=0;ERR=0
 DO I=1,SADDLE_NOCC
  ACTUAL=ACTUAL+SADDLE_V(I)*REAL(OV(I,SADDLE_Q),q)
 ENDDO
 ACTUAL=ACTUAL/(SADDLE_P*BSTEP)
 DO I=1,NB
  DO J=1,NB
   IF(I==J) THEN
    ERR=MAX(ERR,ABS(ORTHO(I,J)-1._q))
   ELSE
    ERR=MAX(ERR,ABS(ORTHO(I,J)))
   ENDIF
  ENDDO
 ENDDO
 IF(.NOT.ieee_is_finite(ACTUAL).OR..NOT.ieee_is_finite(ERR)) &
  CALL vtutor%error('NTO_SADDLE: nonfinite PAW step measurement')
 IF(ERR>1E-5_q) THEN
  CALL OUTWAV(IO,WDES,W,LATT_CUR,EFERMI,EXT='BAD')
  CALL vtutor%error('NTO_SADDLE: PAW orthogonality failed; WAVECAR.BAD saved')
 ENDIF
 SADDLE_ACTUAL=ACTUAL
 IF(.NOT.SADDLE_BEST_READY) THEN
  CALL ALLOCW(WDES,SADDLE_BEST_W);CALL ALLOCW(WDES,SADDLE_BEST_WF)
  SADDLE_BEST_READY=.TRUE.
 ENDIF
 IF(ABS(ACTUAL-SADDLE_A_OUT)<SADDLE_BEST_ERR) THEN
  SADDLE_BEST_ERR=ABS(ACTUAL-SADDLE_A_OUT);SADDLE_BEST_ACTUAL=ACTUAL
  SADDLE_BEST_ORTH=ERR;SADDLE_BEST_CORR=SADDLE_CORRECTION
  SADDLE_BEST_W%CW=W%CW;SADDLE_BEST_W%CPROJ=W%CPROJ;SADDLE_BEST_W%FERTOT=W%FERTOT
  SADDLE_BEST_WF%CW=WF%CW;SADDLE_BEST_WF%CPROJ=WF%CPROJ
 ENDIF
 IF(ABS(ACTUAL-SADDLE_A_OUT)>MAX(1E-6_q,0.01_q*ABS(SADDLE_A_OUT))) THEN
  IF(NTRY<MAXTRY) THEN
   DEALLOCATE(OV,ORTHO)
__GPU CALL OFFLOAD_ON_POP
   RETURN
  ELSE IF(SADDLE_BEST_ERR<5E-4_q) THEN
   W%CW=SADDLE_BEST_W%CW;W%CPROJ=SADDLE_BEST_W%CPROJ;W%FERTOT=SADDLE_BEST_W%FERTOT
   WF%CW=SADDLE_BEST_WF%CW;WF%CPROJ=SADDLE_BEST_WF%CPROJ
   ACTUAL=SADDLE_BEST_ACTUAL;SADDLE_ACTUAL=ACTUAL;ERR=SADDLE_BEST_ORTH
   SADDLE_CORRECTION=SADDLE_BEST_CORR;SADDLE_RELAXED=.TRUE.
   CALL CALC_PAW_OVERLAP(ELEMENTS(SADDLE_W0,WD1,2),ELEMENTS(W,WD1,2),CQIJ,OV)
   IF(IO%IU6>=0) WRITE(IO%IU6,'(A,ES18.9)') 'NTO_SADDLE relaxed best PAW mode deviation ',SADDLE_BEST_ERR
  ELSE
   CALL OUTWAV(IO,WDES,W,LATT_CUR,EFERMI,EXT='BAD')
   CALL vtutor%error('NTO_SADDLE: finite-step mode mismatch exceeds relaxed limit; WAVECAR.BAD saved')
  ENDIF
 ENDIF
 IF(SADDLE_MODE==3.AND.NEL>=2) THEN
  IF(REAL(OV(SADDLE_Q,SADDLE_Q),q)<0.5_q) THEN
   CALL OUTWAV(IO,WDES,W,LATT_CUR,EFERMI,EXT='BAD')
   CALL vtutor%error('NTO_SADDLE SECANT: hole orbital gauge discontinuity')
  ENDIF
  SADDLE_THETA=SADDLE_THETA-ACTUAL*BSTEP*SQRT(SADDLE_P)
 ENDIF
 IF(MOD(NEL,20)==0) THEN
  WRITE(CHECK_EXT,'(I3.3)') NEL
  CALL OUTWAV(IO,WDES,W,LATT_CUR,EFERMI,EXT=CHECK_EXT)
 ENDIF
 IF(SADDLE_H>0.1_q.AND..NOT.SADDLE_H_SAVED) THEN
  CALL OUTWAV(IO,WDES,W,LATT_CUR,EFERMI,EXT='HIT')
  SADDLE_H_SAVED=.TRUE.
 ENDIF
 IF(.NOT.CREATED) THEN
  OPEN(NEWUNIT=U,FILE='NTO_SADDLE_STEP.csv',STATUS='REPLACE',ACTION='WRITE')
  WRITE(U,'(A)') 'ionic_step,step,eta,TIME,a_before,a_after,actual_retracted_a,orthogonality_error,retry_count,mode_correction,step_kind,theta_cumulative,mode_deviation,relaxed_accept'
  CLOSE(U);CREATED=.TRUE.
 ENDIF
 OPEN(NEWUNIT=U,FILE='NTO_SADDLE_STEP.csv',STATUS='OLD',POSITION='APPEND',ACTION='WRITE')
 WRITE(U,'(I0,",",I0,6(",",ES24.16),",",I0,",",ES24.16,",",A,2(",",ES24.16),",",L1)') &
  SADDLE_IONIC_INDEX,NEL,SADDLE_ETA,BSTEP,SADDLE_A_IN,SADDLE_A_OUT,ACTUAL,ERR,NTRY-1,SADDLE_CORRECTION, &
  TRIM(SADDLE_STEP_KIND),SADDLE_THETA,ABS(ACTUAL-SADDLE_A_OUT),SADDLE_RELAXED
 CLOSE(U)
 IF(IO%IU6>=0) WRITE(IO%IU6,'(A,I5,2ES18.9)') 'NTO_SADDLE measured n,a_actual,orth ',NEL,ACTUAL,ERR
 DEALLOCATE(OV,ORTHO)
__GPU CALL OFFLOAD_ON_POP
GPACC !$ACC UPDATE DEVICE(W%CW,W%CPROJ,W%FERTOT,WF%CW,WF%CPROJ) IF(OFFLOAD_ON)
 END SUBROUTINE NTO_SADDLE_MEASURE

! Re-evaluate only the algebraic orbital update, never the Hamiltonian or SCF.
! Restore both W and the incoming orbital velocity before adjusting the single
! CHF mode, then repeat the exact stock update/retraction (at most four times).
 SUBROUTINE NTO_SADDLE_RETRY(W,WF,WDES,CHF,IO,NEL)
__GPU USE moffload
 USE prec
 USE base
 USE wave
 USE tutor, ONLY: vtutor
 USE, INTRINSIC :: ieee_arithmetic, ONLY: ieee_is_finite
 IMPLICIT NONE
 TYPE(wavespin) :: W,WF
 TYPE(wavedes) :: WDES
 TYPE(in_struct) :: IO
 INTEGER :: NEL,I
 GDEF :: CHF(WDES%NB_TOT,WDES%NB_TOT,WDES%NKPTS,WDES%ISPIN)
 REAL(q) :: ERROR,DELTA
 ERROR=SADDLE_A_OUT-SADDLE_ACTUAL
 IF(.NOT.ieee_is_finite(ERROR)) CALL vtutor%error('NTO_SADDLE: nonfinite retry correction')
GPACC !$ACC WAIT IF(OFFLOAD_ON)
GPACC !$ACC UPDATE SELF(CHF) IF(OFFLOAD_ON)
__GPU CALL OFFLOAD_ON_PUSH(.FALSE.)
 W%CW=SADDLE_W0%CW;W%CPROJ=SADDLE_W0%CPROJ
 WF%CW=SADDLE_WF0%CW;WF%CPROJ=SADDLE_WF0%CPROJ
 DO I=1,SADDLE_NOCC
  DELTA=SADDLE_V(I)*ERROR
  CHF(I,SADDLE_Q,1,2)=CHF(I,SADDLE_Q,1,2)+DELTA
  CHF(SADDLE_Q,I,1,2)=CHF(SADDLE_Q,I,1,2)-DELTA
 ENDDO
 SADDLE_CORRECTION=SADDLE_CORRECTION+ERROR
 IF(IO%IU6>=0) WRITE(IO%IU6,'(A,I5,3ES18.9)') &
  'NTO_SADDLE retry n,target,actual,correction ',NEL,SADDLE_A_OUT,SADDLE_ACTUAL,ERROR
__GPU CALL OFFLOAD_ON_POP
GPACC !$ACC UPDATE DEVICE(W%CW,W%CPROJ,WF%CW,WF%CPROJ,CHF) IF(OFFLOAD_ON)
 END SUBROUTINE NTO_SADDLE_RETRY

      
! Native ionic loop hooks. Fixed cell and IWAVPR=0 are the first supported path.
 SUBROUTINE NTO_SADDLE_IONIC_BEGIN(WDES,LATT_CUR,NONLR_S,NONL_S,CQIJ,LMDIM,IO,ISTEP,IWAVPR)
__GPU USE moffload
 USE base
 USE wave
 USE lattice
 USE nonl_struct_def
 USE nonlr_struct_def
 USE nonl_high, ONLY: PROALL
 USE choleski, ONLY: ORTHCH
 USE tutor, ONLY: vtutor
 IMPLICIT NONE
 TYPE(wavedes) :: WDES
 TYPE(latt) :: LATT_CUR
 TYPE(nonlr_struct) :: NONLR_S
 TYPE(nonl_struct) :: NONL_S
 TYPE(in_struct) :: IO
 INTEGER :: LMDIM,ISTEP,IWAVPR
 OVERLAP :: CQIJ(LMDIM,LMDIM,WDES%NIONS,WDES%NCDIJ)
 SADDLE_IONIC_HOOKS=.TRUE.
 SADDLE_IONIC_INDEX=ISTEP
 SADDLE_IONIC_ACCEPTED=.FALSE.
 IF(.NOT.SADDLE_IONIC_FOLLOW) RETURN
 IF(MOD(IWAVPR,10)/=0) CALL vtutor%error('NTO_SADDLE ionic prototype requires IWAVPR=0')
 IF(.NOT.SADDLE_REF_READY) CALL vtutor%error('NTO_SADDLE ionic reference not initialized')
 IF(ISTEP>1) THEN
__GPU CALL OFFLOAD_ON_PUSH(.FALSE.)
  ! Atom-centered projection coefficients from the preceding geometry are stale.
  CALL PROALL(WDES%GRID,LATT_CUR,NONLR_S,NONL_S,SADDLE_REF)
  CALL ORTHCH(WDES,SADDLE_REF,.TRUE.,LMDIM,CQIJ)
__GPU CALL OFFLOAD_ON_POP
  SADDLE_HISTORY=.FALSE.;SADDLE_THETA=0._q;SADDLE_PREV_G=0._q;SADDLE_PREV_THETA=0._q
  SADDLE_KAPPA_WORK_VALID=.FALSE.
  SADDLE_H_SAVED=.FALSE.
  IF(IO%IU6>=0) WRITE(IO%IU6,'(A,I0)') 'NTO_SADDLE ionic local reference reprojected; secant reset step=',ISTEP
 ENDIF
 END SUBROUTINE NTO_SADDLE_IONIC_BEGIN

 SUBROUTINE NTO_SADDLE_IONIC_ACCEPT(W,WDES,LATT_CUR,CQIJ,LMDIM,IO,EFERMI,ISTEP,IWAVPR,ISIF)
__GPU USE moffload
 USE base
 USE wave
 USE lattice
 USE wave_high, ONLY: ELEMENTS
 USE choleski, ONLY: CALC_PAW_OVERLAP
 USE fileio, ONLY: OUTWAV
 USE tutor, ONLY: vtutor
 IMPLICIT NONE
 TYPE(wavespin) :: W
 TYPE(wavedes) :: WDES
 TYPE(wavedes1) :: WD1
 TYPE(latt) :: LATT_CUR
 TYPE(in_struct) :: IO
 INTEGER :: LMDIM,ISTEP,IWAVPR,ISIF,I,J,U,SOURCE_INDEX
 REAL(q) :: EFERMI,PN,DN,ORTHERR,IDVAL,HN,CN
 REAL(q), ALLOCATABLE :: COEF(:),V(:),HH(:,:)
 LOGICAL, ALLOCATABLE :: USED(:)
 GDEF, ALLOCATABLE :: C(:,:),ORTH(:,:)
 OVERLAP :: CQIJ(LMDIM,LMDIM,WDES%NIONS,WDES%NCDIJ)
 IF(.NOT.SADDLE_IONIC_FOLLOW) RETURN
 IF(MOD(IWAVPR,10)/=0.OR.ISIF>2) CALL vtutor%error('NTO_SADDLE ionic prototype requires IWAVPR=0 and fixed cell ISIF<=2')
 IF(.NOT.SADDLE_IONIC_ACCEPTED) THEN
  CALL OUTWAV(IO,WDES,W,LATT_CUR,EFERMI,EXT='BAD')
  CALL vtutor%error('NTO_SADDLE: SECANT not stationary by configured estimates; refusing forces/ionic advancement')
 ENDIF
GPACC !$ACC WAIT IF(OFFLOAD_ON)
GPACC !$ACC UPDATE SELF(W%CW,W%CPROJ,W%FERTOT) IF(OFFLOAD_ON)
__GPU CALL OFFLOAD_ON_PUSH(.FALSE.)
 ALLOCATE(C(WDES%NB_TOT,WDES%NB_TOT),ORTH(WDES%NB_TOT,WDES%NB_TOT), &
  COEF(SADDLE_NOCC),V(SADDLE_NOCC),HH(SADDLE_NOCC,SADDLE_NOCC),USED(WDES%NB_TOT))
 CALL SETWDES(WDES,WD1,1)
 CALL CALC_PAW_OVERLAP(ELEMENTS(W,WD1,2),ELEMENTS(SADDLE_REF,WD1,2),CQIJ,C)
 PN=SUM(ABS(C(1:SADDLE_NOCC,SADDLE_RP))**2)
 HN=SUM(ABS(C(1:SADDLE_NOCC,SADDLE_RH))**2)
 CN=ABS(REAL(SUM(C(1:SADDLE_NOCC,SADDLE_RH)*GCONJG(C(1:SADDLE_NOCC,SADDLE_RP))),q))
 IF(HN>=NTO_SADDLE_H_LIMIT().OR.PN<=NTO_SADDLE_P_LIMIT().OR.CN>=NTO_SADDLE_C_LIMIT()) &
  CALL vtutor%error('NTO_SADDLE: final PAW identity failed before ionic force evaluation')
 COEF=REAL(C(1:SADDLE_NOCC,SADDLE_RP),q)/SQRT(PN)
 ! Householder change of occupied gauge: column191 is the collective particle.
 ! The other190 columns stay orthogonal to it; the occupied projector is unchanged.
 V=COEF;V(SADDLE_NOCC)=V(SADDLE_NOCC)-1._q;DN=SUM(V*V)
 HH=0._q
 DO I=1,SADDLE_NOCC
  HH(I,I)=1._q
 ENDDO
 IF(DN>1E-20_q) THEN
  DO I=1,SADDLE_NOCC
   DO J=1,SADDLE_NOCC
    HH(I,J)=HH(I,J)-2._q*V(I)*V(J)/DN
   ENDDO
  ENDDO
 ENDIF
 IF(SADDLE_FAST.AND.SADDLE_KAPPA_WORK_VALID) THEN
  SADDLE_KAPPA=SADDLE_KAPPA_WORK;SADDLE_KAPPA_VALID=.TRUE.
 ENDIF
 SADDLE_REF%CW=W%CW;SADDLE_REF%CPROJ=W%CPROJ;SADDLE_REF%FERTOT=W%FERTOT
 SADDLE_REF%CW(:,1:SADDLE_NOCC,1,2)=MATMUL(W%CW(:,1:SADDLE_NOCC,1,2),HH)
 SADDLE_REF%CPROJ(:,1:SADDLE_NOCC,1,2)=MATMUL(W%CPROJ(:,1:SADDLE_NOCC,1,2),HH)
 ! Permute the complete local reference: h at RH, collective p at RP.
 ! Reuse the diagnostic scratch wave only after the SCF update has finished.
 IF(.NOT.SADDLE_W0_READY) THEN
  CALL ALLOCW(WDES,SADDLE_W0)
  SADDLE_W0_READY=.TRUE.
 ENDIF
 SADDLE_W0%CW=SADDLE_REF%CW;SADDLE_W0%CPROJ=SADDLE_REF%CPROJ
 USED=.FALSE.;USED(SADDLE_Q)=.TRUE.;USED(SADDLE_NOCC)=.TRUE.;J=1
 DO I=1,WDES%NB_TOT
  IF(I==SADDLE_RH) THEN
   SOURCE_INDEX=SADDLE_Q
  ELSE IF(I==SADDLE_RP) THEN
   SOURCE_INDEX=SADDLE_NOCC
  ELSE
   DO WHILE(USED(J))
    J=J+1
   ENDDO
   SOURCE_INDEX=J;USED(J)=.TRUE.
  ENDIF
  SADDLE_REF%CW(:,I,1,2)=SADDLE_W0%CW(:,SOURCE_INDEX,1,2)
  SADDLE_REF%CPROJ(:,I,1,2)=SADDLE_W0%CPROJ(:,SOURCE_INDEX,1,2)
  SADDLE_REF%FERTOT(I,1,2)=W%FERTOT(SOURCE_INDEX,1,2)
 ENDDO
 CALL CALC_PAW_OVERLAP(ELEMENTS(SADDLE_REF,WD1,2),ELEMENTS(SADDLE_REF,WD1,2),CQIJ,ORTH)
 ORTHERR=0._q
 DO I=1,WDES%NB_TOT
  DO J=1,WDES%NB_TOT
   IDVAL=0._q
   IF(I==J) IDVAL=1._q
   ORTHERR=MAX(ORTHERR,ABS(ORTH(I,J)-IDVAL))
  ENDDO
 ENDDO
 IF(ORTHERR>1E-5_q) CALL vtutor%error('NTO_SADDLE: transported reference PAW orthogonality failed')
 IF(ISTEP==1) THEN
  OPEN(NEWUNIT=U,FILE='NTO_SADDLE_IONIC.csv',STATUS='REPLACE',ACTION='WRITE')
  WRITE(U,'(A)') 'ionic_step,p_before_transport,reference_ortho_error,reference_kind,accepted_estimated_residual'
  CLOSE(U)
 ENDIF
 OPEN(NEWUNIT=U,FILE='NTO_SADDLE_IONIC.csv',STATUS='OLD',POSITION='APPEND',ACTION='WRITE')
 WRITE(U,'(I0,2(",",ES24.16),A)') ISTEP,PN,ORTHERR,',transported-local,T'
 CLOSE(U)
 IF(IO%IU6>=0) WRITE(IO%IU6,'(A,I0,A,ES24.16)') &
  'NTO_SADDLE accepted for native force step=',ISTEP,' transported reference PAW error=',ORTHERR
 DEALLOCATE(C,ORTH,COEF,V,HH,USED)
__GPU CALL OFFLOAD_ON_POP
 END SUBROUTINE NTO_SADDLE_IONIC_ACCEPT


 CHARACTER(LEN=8) FUNCTION NTO_SADDLE_MODE_NAME()
 SELECT CASE(SADDLE_MODE)
 CASE(0)
  NTO_SADDLE_MODE_NAME='OFF'
 CASE(1)
  NTO_SADDLE_MODE_NAME='PROJECT'
 CASE(2)
  NTO_SADDLE_MODE_NAME='REFLECT'
 CASE(3)
  NTO_SADDLE_MODE_NAME='SECANT'
 END SELECT
 END FUNCTION NTO_SADDLE_MODE_NAME

 SUBROUTINE NTO_SADDLE_SCHEDULE(NEL,IO)
 USE base
 IMPLICIT NONE
 INTEGER :: NEL,PREVIOUS
 TYPE(in_struct) :: IO
 PREVIOUS=SADDLE_MODE
 SADDLE_STEP_INDEX=NEL
 IF(SADDLE_IONIC_FOLLOW.AND.SADDLE_IONIC_INDEX>=2) THEN
  IF(NEL<=SADDLE_ION_NPROJECT) THEN
   SADDLE_MODE=1
  ELSE IF(NEL<=SADDLE_ION_NPROJECT+SADDLE_ION_NREFLECT) THEN
   SADDLE_MODE=2;SADDLE_STEP_INDEX=NEL-SADDLE_ION_NPROJECT
  ELSE
   SADDLE_MODE=3;SADDLE_STEP_INDEX=NEL-SADDLE_ION_NPROJECT-SADDLE_ION_NREFLECT
  ENDIF
 ELSE IF(.NOT.SADDLE_AUTO) THEN
  RETURN
 ELSE IF(NEL<=SADDLE_NPROJECT) THEN
  SADDLE_MODE=1
 ELSE IF(NEL<=SADDLE_NPROJECT+SADDLE_NREFLECT) THEN
  SADDLE_MODE=2;SADDLE_STEP_INDEX=NEL-SADDLE_NPROJECT
 ELSE
  SADDLE_MODE=3;SADDLE_STEP_INDEX=NEL-SADDLE_NPROJECT-SADDLE_NREFLECT
 ENDIF
 SADDLE_ETA=-1._q
 IF(SADDLE_MODE==1) SADDLE_ETA=0._q
 IF(PREVIOUS/=SADDLE_MODE) THEN
  SADDLE_HISTORY=.FALSE.;SADDLE_THETA=0._q;SADDLE_PREV_G=0._q;SADDLE_PREV_THETA=0._q
  IF(IO%IU6>=0) WRITE(IO%IU6,'(A,I0,A,A,A,I0)') &
   'NTO_SADDLE AUTO global_step=',NEL,' mode=',TRIM(NTO_SADDLE_MODE_NAME()),' stage_step=',SADDLE_STEP_INDEX
 ENDIF
 END SUBROUTINE NTO_SADDLE_SCHEDULE

! Narrow beta-only PAW operations use VASP's native W1_DOT, including CQIJ.
 REAL(q) FUNCTION NTO_FAST_TIME()
 INTEGER(qi8) :: T,R
 CALL SYSTEM_CLOCK(T,R)
 NTO_FAST_TIME=REAL(T,q)/REAL(MAX(R,1_qi8),q)
 END FUNCTION NTO_FAST_TIME

 INTEGER FUNCTION NTO_SADDLE_MIN_STEP()
 NTO_SADDLE_MIN_STEP=SADDLE_STOP_MIN_STEP
 IF(SADDLE_FAST.AND.SADDLE_IONIC_FOLLOW.AND.SADDLE_IONIC_INDEX>=2) NTO_SADDLE_MIN_STEP=SADDLE_ION_MIN
 END FUNCTION NTO_SADDLE_MIN_STEP

 INTEGER FUNCTION NTO_SADDLE_STREAK()
 NTO_SADDLE_STREAK=SADDLE_STOP_STEPS
 IF(SADDLE_FAST.AND.SADDLE_IONIC_FOLLOW.AND.SADDLE_IONIC_INDEX>=2) NTO_SADDLE_STREAK=SADDLE_ION_STABLE
 END FUNCTION NTO_SADDLE_STREAK

 SUBROUTINE NTO_SADDLE_EARLY_FLAGS
 USE tutor, ONLY: vtutor
 INTEGER :: U,IOS
 CHARACTER(512) :: LINE,KEY,VALUE
 OPEN(NEWUNIT=U,FILE='NTO_SADDLE',STATUS='OLD',ACTION='READ',IOSTAT=IOS)
 IF(IOS/=0) CALL vtutor%error('NTO_SADDLE: cannot read early diagnostic flags')
 DO
  READ(U,'(A)',IOSTAT=IOS) LINE
  IF(IOS<0) EXIT
  IF(IOS/=0) CALL vtutor%error('NTO_SADDLE: early configuration read failed')
  LINE=ADJUSTL(LINE)
  IF(LEN_TRIM(LINE)==0.OR.LINE(1:1)=='#') CYCLE
  READ(LINE,*,IOSTAT=IOS) KEY,VALUE
  IF(IOS/=0) CYCLE
  IF(TRIM(KEY)=='FAST_PATH') READ(VALUE,*,IOSTAT=IOS) SADDLE_FAST
  IF(TRIM(KEY)=='TRACE_FULL_DIAG') READ(VALUE,*,IOSTAT=IOS) SADDLE_FULL_DIAG
  IF(IOS/=0) CALL vtutor%error('NTO_SADDLE: invalid early diagnostic flag')
 ENDDO
 CLOSE(U)
 END SUBROUTINE NTO_SADDLE_EARLY_FLAGS

 REAL(q) FUNCTION NTO_FAST_DOT(WDES,CQIJ,C1,P1,C2,P2)
 USE wave
 USE wave_high, ONLY: W1_DOT
 IMPLICIT NONE
 TYPE(wavedes) :: WDES
 TYPE(wavedes1), TARGET :: D
 TYPE(wavefun1) :: L,R
 COMPLEX(q), CONTIGUOUS,TARGET,INTENT(IN) :: C1(:),C2(:)
 GDEF, CONTIGUOUS,TARGET,INTENT(IN) :: P1(:),P2(:)
 OVERLAP :: CQIJ(:,:,:,:)
 CALL SETWDES(WDES,D,1)
 L%WDES1=>D;R%WDES1=>D
 L%CW=>C1;R%CW=>C2;L%CPROJ=>P1;R%CPROJ=>P2
 L%ISP=2;R%ISP=2;L%LDO=.TRUE.;R%LDO=.TRUE.
 NTO_FAST_DOT=REAL(W1_DOT(L,R,CQIJ),q)
 END FUNCTION NTO_FAST_DOT

 SUBROUTINE CALC_PAW_OVERLAP_VEC(WLEFT,WRIGHT,WDES,CQIJ,BANDS,OV)
 USE wave
 USE wave_high, ONLY: ELEMENT,W1_DOT
 USE tutor, ONLY: vtutor
 IMPLICIT NONE
 TYPE(wavespin) :: WLEFT,WRIGHT
 TYPE(wavedes) :: WDES
 TYPE(wavedes1), TARGET :: D
 TYPE(wavefun1) :: L,R
 INTEGER :: BANDS(:),I,J
 GDEF :: OV(:,:)
 OVERLAP :: CQIJ(:,:,:,:)
 IF(SIZE(OV,1)/=WDES%NB_TOT.OR.SIZE(OV,2)/=SIZE(BANDS)) &
  CALL vtutor%error('NTO_SADDLE: narrow PAW output shape mismatch')
 CALL SETWDES(WDES,D,1)
 DO J=1,SIZE(BANDS)
  R=ELEMENT(WRIGHT,D,BANDS(J),2)
  DO I=1,WDES%NB_TOT
   L=ELEMENT(WLEFT,D,I,2)
   OV(I,J)=W1_DOT(L,R,CQIJ)
  ENDDO
 ENDDO
 END SUBROUTINE CALC_PAW_OVERLAP_VEC

 SUBROUTINE NTO_FAST_TRACE(W,WDES,LATT_CUR,CQIJ,LMDIM,IO,CHAM,NEL,IFLAG,BTRIAL,EFERMI,LCHCON)
__GPU USE moffload
 USE wave
 USE wave_high, ONLY: ELEMENTS
 USE base
 USE lattice
 USE choleski, ONLY: CALC_PAW_OVERLAP
 USE fileio, ONLY: OUTWAV
 USE fock_ace, ONLY: LFOCK_ACE
 USE tutor, ONLY: vtutor
 IMPLICIT NONE
 TYPE(wavespin) :: W
 TYPE(wavedes) :: WDES
 TYPE(wavedes1) :: D
 TYPE(in_struct) :: IO
 TYPE(latt) :: LATT_CUR
 LOGICAL :: LCHCON
 INTEGER :: LMDIM,NEL,IFLAG,I,J,U,NB
 OVERLAP :: CQIJ(LMDIM,LMDIM,WDES%NIONS,WDES%NCDIJ)
 GDEF :: CHAM(:,:,:,:)
 GDEF,ALLOCATABLE :: C(:,:),FULL(:,:)
 REAL(q) :: BTRIAL,EFERMI,H,P,COH,CMAX,LH,LP,GM,RPERP,RSUB,REXT,REST,RTOT,HOLE,T0
 CHARACTER(16) :: FK,RULE
 CHARACTER(1) :: ACEFEATURE
 T0=NTO_FAST_TIME();ACEFEATURE='F'
 IF(LFOCK_ACE()) ACEFEATURE='T'
GPACC !$ACC WAIT IF(OFFLOAD_ON)
GPACC !$ACC UPDATE SELF(W%CW(:,:,1,2),W%CPROJ(:,:,1,2),W%FERTOT,CHAM(:,:,:,2)) IF(OFFLOAD_ON)
__GPU CALL OFFLOAD_ON_PUSH(.FALSE.)
 NB=WDES%NB_TOT;ALLOCATE(C(NB,2))
 CALL CALC_PAW_OVERLAP_VEC(W,SADDLE_REF,WDES,CQIJ,(/SADDLE_RH,SADDLE_RP/),C)
 S_FAST_VEC_ERROR=-1._q
 IF(SADDLE_FULL_DIAG) THEN
  ALLOCATE(FULL(NB,NB));CALL SETWDES(WDES,D,1)
  CALL CALC_PAW_OVERLAP(ELEMENTS(W,D,2),ELEMENTS(SADDLE_REF,D,2),CQIJ,FULL)
  S_FAST_VEC_ERROR=MAX(MAXVAL(ABS(C(:,1)-FULL(:,SADDLE_RH))),MAXVAL(ABS(C(:,2)-FULL(:,SADDLE_RP))))
  IF(S_FAST_VEC_ERROR>1E-10_q) CALL vtutor%error('NTO_SADDLE: narrow/full PAW mismatch')
  DEALLOCATE(FULL)
 ENDIF
 IF(MAXVAL(ABS(W%FERTOT(1:SADDLE_NOCC,1,2)-1._q))>1E-7_q.OR. &
    MAXVAL(ABS(W%FERTOT(SADDLE_NOCC+1:NB,1,2)))>1E-7_q) &
  CALL vtutor%error('NTO_SADDLE: canonical binary beta mask required')
 H=SUM(ABS(C(1:SADDLE_NOCC,1))**2);P=SUM(ABS(C(1:SADDLE_NOCC,2))**2)
 COH=REAL(SUM(C(1:SADDLE_NOCC,1)*GCONJG(C(1:SADDLE_NOCC,2))),q)
 CMAX=SQRT(MAX(0._q,MIN(H*(1-H),P*(1-P))))
 LH=H*(1-H)-COH*COH;LP=P*(1-P)-COH*COH;HOLE=ABS(C(SADDLE_Q,1))**2
 IF(P<=1E-14_q) CALL vtutor%error('NTO_SADDLE: particle projection is zero')
 IF(SADDLE_MODE/=0) THEN
  IF(P<0.5_q.OR.HOLE<0.5_q) THEN
   CALL OUTWAV(IO,WDES,W,LATT_CUR,EFERMI,EXT='BAD')
   CALL vtutor%error('NTO_SADDLE: mode identity lost')
  ENDIF
  IF(.NOT.ALLOCATED(SADDLE_V)) ALLOCATE(SADDLE_V(SADDLE_NOCC))
  SADDLE_V=REAL(C(1:SADDLE_NOCC,2),q)
 ENDIF
 SADDLE_H=H;SADDLE_P=P;SADDLE_C_ABS=ABS(COH);SADDLE_C_REAL=COH
 S_FAST_HU=COH/SQRT(P);S_FAST_PU=SQRT(P)
 S_FAST_HQ=REAL(C(SADDLE_Q,1),q);S_FAST_PQ=REAL(C(SADDLE_Q,2),q)
 GM=0;SADDLE_DENOM=0;RSUB=0
 DO I=1,SADDLE_NOCC
  GM=GM+REAL(CHAM(SADDLE_Q,I,1,2)*C(I,2),q)/SQRT(P)
  SADDLE_DENOM=SADDLE_DENOM+REAL(C(I,2),q)**2* &
   (ABS(REAL(CHAM(SADDLE_Q,SADDLE_Q,1,2)-CHAM(I,I,1,2),q))+MERGE(0._q,1.4_q,LCHCON))
  DO J=SADDLE_NOCC+1,NB
   RSUB=RSUB+ABS(CHAM(J,I,1,2))**2
  ENDDO
 ENDDO
 SADDLE_DENOM=SADDLE_DENOM/P;SADDLE_G_RAW=GM
 RPERP=SQRT(MAX(0._q,RSUB-GM*GM));RSUB=SQRT(RSUB);SADDLE_RPERP_SUB=RPERP
 SADDLE_RPERP_EST=HUGE(1._q);RULE='FAST_SUBSPACE'
 IF(SADDLE_FULL_DIAG) THEN
  REXT=SQRT(MAX(0._q,SADDLE_RAW_EXT2))
  REST=SQRT((RPERP**2+REXT**2)/REAL(SADDLE_NOCC,q))
  RTOT=SQRT((RSUB**2+REXT**2)/REAL(SADDLE_NOCC,q));SADDLE_RPERP_EST=REST;RULE='ESTIMATED_PAW'
 ENDIF
 FK='MISSING'
#ifdef fock_dblbuf
 FK='full'
#endif
 OPEN(NEWUNIT=U,FILE='NTO_SADDLE_TRACE.csv',STATUS='OLD',POSITION='APPEND',ACTION='WRITE')
 WRITE(U,'(I0,",",I0,",",I0,",",A,17(",",ES24.16))',ADVANCE='NO') &
  SADDLE_IONIC_INDEX,NEL,IFLAG,TRIM(NTO_SADDLE_MODE_NAME()),SADDLE_ETA,BTRIAL, &
  H,P,COH,ABS(COH),ABS(COH)/MAX(CMAX,TINY(CMAX)),LH,LP,P,HOLE, &
  W%FERTOT(SADDLE_NOCC,1,2),W%FERTOT(SADDLE_Q,1,2),GM,ABS(GM),RPERP,RSUB
 IF(SADDLE_FULL_DIAG) THEN
  WRITE(U,'(3(",",ES24.16))',ADVANCE='NO') REXT,REST,RTOT
 ELSE
  WRITE(U,'(A)',ADVANCE='NO') ',MISSING,MISSING,MISSING'
 ENDIF
 WRITE(U,'(A)') ',EDWAV+IROT3,'//TRIM(FK)//',F,'//ACEFEATURE//','//TRIM(RULE)//',MISSING'
 CLOSE(U)
 IF(IO%IU6>=0) WRITE(IO%IU6,'(A,I0,A,5ES18.9)') &
  'NTO_FAST step=',NEL,' h,p,c,g_raw,Rperp_sub ',H,P,COH,GM,RPERP
 DEALLOCATE(C)
__GPU CALL OFFLOAD_ON_POP
 S_FAST_TRACE_TIME=NTO_FAST_TIME()-T0
 END SUBROUTINE NTO_FAST_TRACE

 SUBROUTINE NTO_FAST_PROJECT(W,WF,WDES,CQIJ,CHF,IO,NEL,IROT,BTRIAL)
__GPU USE moffload
 USE wave
 USE base
 USE tutor, ONLY: vtutor
 USE, INTRINSIC :: ieee_arithmetic, ONLY: ieee_is_finite
 IMPLICIT NONE
 TYPE(wavespin) :: W,WF
 TYPE(wavedes) :: WDES
 TYPE(wavedes1) :: D
 TYPE(in_struct) :: IO
 OVERLAP :: CQIJ(:,:,:,:)
 GDEF :: CHF(:,:,:,:)
 INTEGER :: NEL,IROT,I,NP
 REAL(q) :: BTRIAL,A,TARGET,QWF,UWFQ,DELTA,RATIO,K,T0,AFTER
 REAL(q),ALLOCATABLE :: VH(:)
 COMPLEX(q),ALLOCATABLE :: VC(:)
 GDEF,ALLOCATABLE :: VP(:)
 IF(IROT/=3.OR..NOT.ALLOCATED(SADDLE_V)) CALL vtutor%error('NTO_FAST: unsupported rotation path')
 T0=NTO_FAST_TIME();CALL SETWDES(WDES,D,1);NP=D%NPL
GPACC !$ACC WAIT IF(OFFLOAD_ON)
GPACC !$ACC UPDATE SELF(W%CW(:,:,1,2),W%CPROJ(:,:,1,2),WF%CW(:,:,1,2),WF%CPROJ(:,:,1,2),CHF(:,:,:,2)) IF(OFFLOAD_ON)
__GPU CALL OFFLOAD_ON_PUSH(.FALSE.)
 IF(.NOT.ASSOCIATED(S_FAST_U)) THEN
  ALLOCATE(S_FAST_U(NP),S_FAST_Q(NP),S_FAST_UP(SIZE(W%CPROJ,1)),S_FAST_QP(SIZE(W%CPROJ,1)))
 ENDIF
 ALLOCATE(VH(SADDLE_NOCC),VC(NP),VP(SIZE(W%CPROJ,1)))
 VH=SADDLE_V/SQRT(SADDLE_P)
 S_FAST_U=MATMUL(W%CW(1:NP,1:SADDLE_NOCC,1,2),VH)
 S_FAST_UP=MATMUL(W%CPROJ(:,1:SADDLE_NOCC,1,2),VH)
 S_FAST_Q=W%CW(1:NP,SADDLE_Q,1,2);S_FAST_QP=W%CPROJ(:,SADDLE_Q,1,2)
 VC=MATMUL(WF%CW(1:NP,1:SADDLE_NOCC,1,2),VH)
 VP=MATMUL(WF%CPROJ(:,1:SADDLE_NOCC,1,2),VH)
 QWF=NTO_FAST_DOT(WDES,CQIJ,S_FAST_Q,S_FAST_QP,VC,VP)
 UWFQ=NTO_FAST_DOT(WDES,CQIJ,S_FAST_U,S_FAST_UP,WF%CW(1:NP,SADDLE_Q,1,2),WF%CPROJ(:,SADDLE_Q,1,2))
 A=SUM(SADDLE_V*REAL(CHF(1:SADDLE_NOCC,SADDLE_Q,1,2),q))/SADDLE_P+QWF/SQRT(SADDLE_P)
 IF(.NOT.ieee_is_finite(A)) CALL vtutor%error('NTO_FAST: nonfinite physical direction')
 CALL NTO_FAST_TARGET(A,BTRIAL,NEL,TARGET)
 RATIO=SADDLE_ETA
 IF(ABS(A)>1E-14_q) RATIO=TARGET/A
 IF(NEL==1.OR.SADDLE_MODE==1) RATIO=0._q
 ! Filter the anti-Hermitian selected velocity mode, retaining all other modes.
 K=0.5_q*(QWF-UWFQ);S_FAST_VEL_BEFORE=K;DELTA=(RATIO-1._q)*K
 DO I=1,SADDLE_NOCC
  WF%CW(1:NP,I,1,2)=WF%CW(1:NP,I,1,2)+VH(I)*DELTA*S_FAST_Q
  WF%CPROJ(:,I,1,2)=WF%CPROJ(:,I,1,2)+VH(I)*DELTA*S_FAST_QP
 ENDDO
 WF%CW(1:NP,SADDLE_Q,1,2)=WF%CW(1:NP,SADDLE_Q,1,2)-DELTA*S_FAST_U
 WF%CPROJ(:,SADDLE_Q,1,2)=WF%CPROJ(:,SADDLE_Q,1,2)-DELTA*S_FAST_UP
 VC=MATMUL(WF%CW(1:NP,1:SADDLE_NOCC,1,2),VH)
 VP=MATMUL(WF%CPROJ(:,1:SADDLE_NOCC,1,2),VH)
 QWF=NTO_FAST_DOT(WDES,CQIJ,S_FAST_Q,S_FAST_QP,VC,VP)
 UWFQ=NTO_FAST_DOT(WDES,CQIJ,S_FAST_U,S_FAST_UP,WF%CW(1:NP,SADDLE_Q,1,2),WF%CPROJ(:,SADDLE_Q,1,2))
 S_FAST_VEL_AFTER=0.5_q*(QWF-UWFQ)
 IF(ABS(S_FAST_VEL_AFTER-RATIO*K)>1E-9_q*MAX(1._q,ABS(K))) &
  CALL vtutor%error('NTO_FAST: velocity mode filtering mismatch')
 AFTER=SUM(SADDLE_V*REAL(CHF(1:SADDLE_NOCC,SADDLE_Q,1,2),q))/SADDLE_P+QWF/SQRT(SADDLE_P)
 DO I=1,SADDLE_NOCC
  DELTA=(TARGET-AFTER)*SADDLE_V(I)
  CHF(I,SADDLE_Q,1,2)=CHF(I,SADDLE_Q,1,2)+DELTA
  CHF(SADDLE_Q,I,1,2)=CHF(SADDLE_Q,I,1,2)-DELTA
 ENDDO
 SADDLE_A_OUT=SUM(SADDLE_V*REAL(CHF(1:SADDLE_NOCC,SADDLE_Q,1,2),q))/SADDLE_P+QWF/SQRT(SADDLE_P)
 IF(ABS(SADDLE_A_OUT-TARGET)>1E-10_q*MAX(1._q,ABS(TARGET))) &
  CALL vtutor%error('NTO_FAST: total-direction mode map mismatch')
 SADDLE_ACTUAL=0;SADDLE_CORRECTION=0;SADDLE_RELAXED=.FALSE.
 DEALLOCATE(VH,VC,VP)
__GPU CALL OFFLOAD_ON_POP
GPACC !$ACC UPDATE DEVICE(WF%CW(:,:,1,2),WF%CPROJ(:,:,1,2),CHF(:,:,:,2)) IF(OFFLOAD_ON)
 S_FAST_PROJECT_TIME=NTO_FAST_TIME()-T0
 END SUBROUTINE NTO_FAST_PROJECT

 SUBROUTINE NTO_FAST_MEASURE(W,WF,WDES,LATT_CUR,CQIJ,IO,NEL,BSTEP,EFERMI)
__GPU USE moffload
 USE wave
 USE wave_high, ONLY: ELEMENTS
 USE base
 USE lattice
 USE choleski, ONLY: CALC_PAW_OVERLAP
 USE fileio, ONLY: OUTWAV
 USE tutor, ONLY: vtutor
 USE, INTRINSIC :: ieee_arithmetic, ONLY: ieee_is_finite
 IMPLICIT NONE
 TYPE(wavespin) :: W,WF
 TYPE(wavedes) :: WDES
 TYPE(wavedes1) :: D
 TYPE(latt) :: LATT_CUR
 TYPE(in_struct) :: IO
 OVERLAP :: CQIJ(:,:,:,:)
 INTEGER :: NEL,NP,I,J,U,NB
 REAL(q) :: BSTEP,EFERMI,B,C,R,Y,PHI,D1,D2,ANGLE,PI,CS,SN,ACTUAL,ERROR,T0,ID
 COMPLEX(q),ALLOCATABLE :: UC(:),QC(:),VC(:),VQC(:),DU(:)
 GDEF,ALLOCATABLE :: UP(:),QP(:),VP(:),VQP(:),DP(:),GRAM(:,:)
 REAL(q),ALLOCATABLE :: VH(:)
 LOGICAL,SAVE :: CREATED=.FALSE.
 CHARACTER(3) :: EXT
 T0=NTO_FAST_TIME();CALL SETWDES(WDES,D,1);NP=D%NPL;NB=WDES%NB_TOT
GPACC !$ACC WAIT IF(OFFLOAD_ON)
GPACC !$ACC UPDATE SELF(W%CW(:,:,1,2),W%CPROJ(:,:,1,2),WF%CW(:,:,1,2),WF%CPROJ(:,:,1,2)) IF(OFFLOAD_ON)
__GPU CALL OFFLOAD_ON_PUSH(.FALSE.)
 ALLOCATE(VH(SADDLE_NOCC),UC(NP),QC(NP),VC(NP),VQC(NP),DU(NP), &
  UP(SIZE(W%CPROJ,1)),QP(SIZE(W%CPROJ,1)),VP(SIZE(W%CPROJ,1)),VQP(SIZE(W%CPROJ,1)),DP(SIZE(W%CPROJ,1)))
 VH=SADDLE_V/SQRT(SADDLE_P)
 UC=MATMUL(W%CW(1:NP,1:SADDLE_NOCC,1,2),VH);UP=MATMUL(W%CPROJ(:,1:SADDLE_NOCC,1,2),VH)
 QC=W%CW(1:NP,SADDLE_Q,1,2);QP=W%CPROJ(:,SADDLE_Q,1,2)
 B=NTO_FAST_DOT(WDES,CQIJ,S_FAST_U,S_FAST_UP,QC,QP)
 C=NTO_FAST_DOT(WDES,CQIJ,S_FAST_U,S_FAST_UP,UC,UP)
 R=SQRT(B*B+C*C);Y=SADDLE_A_OUT*BSTEP*SQRT(SADDLE_P)
 IF(R<1E-12_q.OR.ABS(Y)>R+1E-12_q.OR..NOT.ieee_is_finite(R)) THEN
  CALL OUTWAV(IO,WDES,W,LATT_CUR,EFERMI,EXT='BAD')
  CALL vtutor%error('NTO_FAST: requested mode overlap is outside the transported two-plane')
 ENDIF
 Y=MAX(-1._q,MIN(1._q,Y/R));PI=ACOS(-1._q);PHI=ATAN2(B,C)
 D1=MODULO(ASIN(Y)-PHI+PI,2*PI)-PI
 D2=MODULO(PI-ASIN(Y)-PHI+PI,2*PI)-PI
 ANGLE=D1
 IF(ABS(D2)<ABS(D1)) ANGLE=D2
 CS=COS(ANGLE);SN=SIN(ANGLE);S_FAST_DELTA=ANGLE
 DU=(CS-1)*UC-SN*QC;DP=(CS-1)*UP-SN*QP
 VC=MATMUL(WF%CW(1:NP,1:SADDLE_NOCC,1,2),VH);VP=MATMUL(WF%CPROJ(:,1:SADDLE_NOCC,1,2),VH)
 VQC=WF%CW(1:NP,SADDLE_Q,1,2);VQP=WF%CPROJ(:,SADDLE_Q,1,2)
 DO I=1,SADDLE_NOCC
  W%CW(1:NP,I,1,2)=W%CW(1:NP,I,1,2)+VH(I)*DU
  W%CPROJ(:,I,1,2)=W%CPROJ(:,I,1,2)+VH(I)*DP
  WF%CW(1:NP,I,1,2)=WF%CW(1:NP,I,1,2)+VH(I)*((CS-1)*VC-SN*VQC)
  WF%CPROJ(:,I,1,2)=WF%CPROJ(:,I,1,2)+VH(I)*((CS-1)*VP-SN*VQP)
 ENDDO
 W%CW(1:NP,SADDLE_Q,1,2)=CS*QC+SN*UC;W%CPROJ(:,SADDLE_Q,1,2)=CS*QP+SN*UP
 WF%CW(1:NP,SADDLE_Q,1,2)=CS*VQC+SN*VC;WF%CPROJ(:,SADDLE_Q,1,2)=CS*VQP+SN*VP
 ACTUAL=NTO_FAST_DOT(WDES,CQIJ,S_FAST_U,S_FAST_UP,W%CW(1:NP,SADDLE_Q,1,2),W%CPROJ(:,SADDLE_Q,1,2)) &
  /(BSTEP*SQRT(SADDLE_P))
 ERROR=ABS(ACTUAL-SADDLE_A_OUT);SADDLE_ACTUAL=ACTUAL;SADDLE_CORRECTION=ANGLE
 IF(.NOT.ieee_is_finite(ACTUAL).OR.ERROR>1E-10_q*MAX(1._q,ABS(SADDLE_A_OUT))) THEN
  CALL OUTWAV(IO,WDES,W,LATT_CUR,EFERMI,EXT='BAD')
  CALL vtutor%error('NTO_FAST: exact finite-angle mode correction failed')
 ENDIF
 IF(SADDLE_MODE==3.AND.NEL>=2) THEN
  IF(NTO_FAST_DOT(WDES,CQIJ,S_FAST_Q,S_FAST_QP,W%CW(1:NP,SADDLE_Q,1,2),W%CPROJ(:,SADDLE_Q,1,2))<0.5_q) &
   CALL vtutor%error('NTO_FAST: hole gauge continuity lost')
  SADDLE_THETA=SADDLE_THETA-ACTUAL*BSTEP*SQRT(SADDLE_P)
 ENDIF
 S_FAST_FULL_ORTH=-1._q
 IF(SADDLE_FULL_DIAG) THEN
  ALLOCATE(GRAM(NB,NB))
  CALL CALC_PAW_OVERLAP(ELEMENTS(W,D,2),ELEMENTS(W,D,2),CQIJ,GRAM)
  S_FAST_FULL_ORTH=0
  DO I=1,NB
   DO J=1,NB
    ID=0
    IF(I==J) ID=1
    S_FAST_FULL_ORTH=MAX(S_FAST_FULL_ORTH,ABS(GRAM(I,J)-ID))
   ENDDO
  ENDDO
  IF(S_FAST_FULL_ORTH>1E-8_q) CALL vtutor%error('NTO_FAST: debug global PAW orthogonality check failed')
  DEALLOCATE(GRAM)
 ENDIF
 IF(MOD(NEL,20)==0) THEN
  WRITE(EXT,'(I3.3)') NEL
  CALL OUTWAV(IO,WDES,W,LATT_CUR,EFERMI,EXT=EXT)
 ENDIF
 IF(.NOT.CREATED) THEN
  OPEN(NEWUNIT=U,FILE='NTO_SADDLE_STEP.csv',STATUS='REPLACE',ACTION='WRITE')
  WRITE(U,'(A)') 'ionic_step,step,eta,TIME,a_before,a_after,actual_retracted_a,orthogonality_error,'// &
   'retry_count,mode_correction,step_kind,theta_cumulative,mode_deviation,relaxed_accept'
  CLOSE(U)
  OPEN(NEWUNIT=U,FILE='NTO_FAST_TIMING.csv',STATUS='REPLACE',ACTION='WRITE')
  WRITE(U,'(A)') 'ionic_step,step,trace_seconds,project_seconds,measure_seconds,correction_angle,'// &
   'mode_error,velocity_mode_before,velocity_mode_after,vec_vs_full_error,full_ortho_error,kappa_saved,kappa_valid,trust_active'
  CLOSE(U);CREATED=.TRUE.
 ENDIF
 OPEN(NEWUNIT=U,FILE='NTO_SADDLE_STEP.csv',STATUS='OLD',POSITION='APPEND',ACTION='WRITE')
 WRITE(U,'(I0,",",I0,5(",",ES24.16))',ADVANCE='NO') &
  SADDLE_IONIC_INDEX,NEL,SADDLE_ETA,BSTEP,SADDLE_A_IN,SADDLE_A_OUT,ACTUAL
 IF(SADDLE_FULL_DIAG) THEN
  WRITE(U,'(",",ES24.16)',ADVANCE='NO') S_FAST_FULL_ORTH
 ELSE
  WRITE(U,'(A)',ADVANCE='NO') ',MISSING'
 ENDIF
 WRITE(U,'(A,ES24.16,A,2(ES24.16,A))') ',0,',ANGLE,',EXACT_GIVENS,',SADDLE_THETA,',',ERROR,',F'
 CLOSE(U)
 S_FAST_MEASURE_TIME=NTO_FAST_TIME()-T0
 OPEN(NEWUNIT=U,FILE='NTO_FAST_TIMING.csv',STATUS='OLD',POSITION='APPEND',ACTION='WRITE')
 WRITE(U,'(I0,",",I0,7(",",ES24.16))',ADVANCE='NO') &
  SADDLE_IONIC_INDEX,NEL,S_FAST_TRACE_TIME,S_FAST_PROJECT_TIME,S_FAST_MEASURE_TIME,ANGLE,ERROR, &
  S_FAST_VEL_BEFORE,S_FAST_VEL_AFTER
 IF(SADDLE_FULL_DIAG) THEN
  WRITE(U,'(2(",",ES24.16))',ADVANCE='NO') S_FAST_VEC_ERROR,S_FAST_FULL_ORTH
 ELSE
  WRITE(U,'(A)',ADVANCE='NO') ',MISSING,MISSING'
 ENDIF
 IF(SADDLE_KAPPA_VALID) THEN
  WRITE(U,'(",",ES24.16)',ADVANCE='NO') SADDLE_KAPPA
 ELSE
  WRITE(U,'(A)',ADVANCE='NO') ',MISSING'
 ENDIF
 WRITE(U,'(2(",",L1))') SADDLE_KAPPA_VALID,SADDLE_TRUST_ACTIVE
 CLOSE(U)
 DEALLOCATE(VH,UC,QC,VC,VQC,DU,UP,QP,VP,VQP,DP)
__GPU CALL OFFLOAD_ON_POP
GPACC !$ACC UPDATE DEVICE(W%CW(:,:,1,2),W%CPROJ(:,:,1,2),WF%CW(:,:,1,2),WF%CPROJ(:,:,1,2)) IF(OFFLOAD_ON)
 END SUBROUTINE NTO_FAST_MEASURE

 SUBROUTINE NTO_FAST_TARGET(A,BTRIAL,NEL,TARGET)
 USE tutor, ONLY: vtutor
 USE, INTRINSIC :: ieee_arithmetic, ONLY: ieee_is_finite
 IMPLICIT NONE
 INTEGER :: NEL,ITRUST
 REAL(q) :: A,BTRIAL,TARGET,DTHETA,DG,DT
 SADDLE_A_IN=A
 TARGET=SADDLE_ETA*A;SADDLE_STEP_KIND='REFLECT_FALLBACK'
 IF(SADDLE_MODE==1) SADDLE_STEP_KIND='PROJECT'
 IF(SADDLE_MODE==2) SADDLE_STEP_KIND='REFLECT'
 IF(NEL==1) THEN
  ! Initial SDA step: project the mode for every active optimizer; do not
  ! bootstrap, reflect, or store secant history until the following step.
  TARGET=0._q;SADDLE_STEP_KIND='INITIAL_PROJECT'
 ELSE IF(SADDLE_MODE==3) THEN
  IF(SADDLE_KAPPA_VALID.AND.SADDLE_IONIC_INDEX>=2.AND. &
     (.NOT.SADDLE_HISTORY.OR.SADDLE_RPERP_SUB>10*SADDLE_STOP_RSUB)) THEN
   DTHETA=-0.35_q*SADDLE_G_RAW/SADDLE_KAPPA
   DTHETA=MAX(-0.02_q,MIN(0.02_q,DTHETA))
   TARGET=-DTHETA/(BTRIAL*SQRT(SADDLE_P));SADDLE_STEP_KIND='CURVATURE_CARRY'
  ELSE IF(SADDLE_HISTORY) THEN
   DG=SADDLE_G_RAW-SADDLE_PREV_G;DT=SADDLE_THETA-SADDLE_PREV_THETA
   IF(ABS(DT)>1E-7_q.AND.ABS(DG)>1E-9_q.AND.SADDLE_RPERP_SUB<=10*SADDLE_STOP_RSUB) THEN
    SADDLE_KAPPA_WORK=DG/DT
    SADDLE_KAPPA_WORK_VALID=ieee_is_finite(SADDLE_KAPPA_WORK).AND.ABS(SADDLE_KAPPA_WORK)>1E-8_q
   ENDIF
   IF(ABS(DG)>1E-8_q.AND.ABS(DT)>1E-10_q) THEN
    DTHETA=-0.35_q*SADDLE_G_RAW*DT/DG
    DTHETA=MAX(-0.02_q,MIN(0.02_q,DTHETA))
    TARGET=-DTHETA/(BTRIAL*SQRT(SADDLE_P))
    SADDLE_STEP_KIND='SECANT'
   ENDIF
  ENDIF
  IF(SADDLE_STEP_KIND=='REFLECT_FALLBACK'.AND.ABS(TARGET)<1E-10_q.AND.ABS(SADDLE_G_RAW)>1E-5_q) THEN
   IF(SADDLE_DENOM<=1E-8_q.OR..NOT.ieee_is_finite(SADDLE_DENOM)) &
    CALL vtutor%error('NTO_SADDLE SECANT: invalid bootstrap denominator')
   TARGET=-SADDLE_G_RAW/(SQRT(SADDLE_P)*SADDLE_DENOM)
   DTHETA=MAX(-0.02_q,MIN(0.02_q,-TARGET*BTRIAL*SQRT(SADDLE_P)))
   TARGET=-DTHETA/(BTRIAL*SQRT(SADDLE_P))
   SADDLE_STEP_KIND='BOOTSTRAP_RAW_G'
  ENDIF
  IF(TARGET*A>0._q) THEN
   TARGET=-A
   SADDLE_STEP_KIND='SIGN_REFLECT_FALLBACK'
  ENDIF
  IF(SADDLE_HISTORY.AND.SADDLE_G_RAW*SADDLE_PREV_G<0._q) THEN
   TARGET=-0.5_q*A
   SADDLE_STEP_KIND='ROOT_CROSS_DAMPED'
  ENDIF
  IF(ABS(TARGET)>2.5_q*ABS(A)) THEN
   TARGET=SIGN(2.5_q*ABS(A),TARGET)
   SADDLE_STEP_KIND='STEP_CAP_2P5'
  ENDIF
  SADDLE_PREV_G=SADDLE_G_RAW;SADDLE_PREV_THETA=SADDLE_THETA;SADDLE_HISTORY=.TRUE.
 ENDIF
 SADDLE_TRUST_ACTIVE=.FALSE.
 IF(SADDLE_TRUST_C.AND..NOT.SADDLE_IONIC_FOLLOW.AND.SADDLE_MODE==3.AND. &
    SADDLE_C_ABS>SADDLE_TRUST_MAX) THEN
  IF(ABS(NTO_FAST_C_PREDICT(TARGET*BTRIAL*SQRT(SADDLE_P)))>SADDLE_C_ABS) THEN
   TARGET=-TARGET
   DO ITRUST=1,12
    IF(ABS(NTO_FAST_C_PREDICT(TARGET*BTRIAL*SQRT(SADDLE_P)))<=SADDLE_C_ABS) EXIT
    TARGET=0.5_q*TARGET
   ENDDO
   SADDLE_TRUST_ACTIVE=.TRUE.;SADDLE_STEP_KIND='TRUST_C_RETURN'
  ENDIF
 ENDIF
 END SUBROUTINE NTO_FAST_TARGET


 REAL(q) FUNCTION NTO_SADDLE_H_LIMIT()
 NTO_SADDLE_H_LIMIT=SADDLE_STOP_H
 IF(SADDLE_IONIC_FOLLOW.AND.SADDLE_IONIC_INDEX>=2) NTO_SADDLE_H_LIMIT=SADDLE_ION_H_MAX
 END FUNCTION NTO_SADDLE_H_LIMIT
 REAL(q) FUNCTION NTO_SADDLE_P_LIMIT()
 NTO_SADDLE_P_LIMIT=SADDLE_STOP_P
 IF(SADDLE_IONIC_FOLLOW.AND.SADDLE_IONIC_INDEX>=2) NTO_SADDLE_P_LIMIT=SADDLE_ION_P_MIN
 END FUNCTION NTO_SADDLE_P_LIMIT
 REAL(q) FUNCTION NTO_SADDLE_C_LIMIT()
 NTO_SADDLE_C_LIMIT=SADDLE_STOP_C
 IF(SADDLE_IONIC_FOLLOW.AND.SADDLE_IONIC_INDEX>=2) NTO_SADDLE_C_LIMIT=SADDLE_ION_C_MAX
 END FUNCTION NTO_SADDLE_C_LIMIT
 REAL(q) FUNCTION NTO_FAST_C_PREDICT(ANGLE)
 REAL(q) :: ANGLE,C,S
 C=COS(ANGLE);S=SIN(ANGLE)
 NTO_FAST_C_PREDICT=SADDLE_C_REAL+S*S*(S_FAST_HQ*S_FAST_PQ-S_FAST_HU*S_FAST_PU) &
  -C*S*(S_FAST_HU*S_FAST_PQ+S_FAST_HQ*S_FAST_PU)
 END FUNCTION NTO_FAST_C_PREDICT
END MODULE
